---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { getAllPosts } from "../utils/getPosts";

// Definición de variables en el Frontmatter [cite: 1]
const POSTS_PER_PAGE = 6; 
const allPosts = getAllPosts();
const postsData = allPosts; // Lo pasamos como objeto, Astro lo serializa solo
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Evidencia Parcial I</title>
    
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches; [cite: 3]
        const initialTheme = savedTheme === "system" ? (prefersDark ? "dark" : "light") : savedTheme;
        if (initialTheme === "dark") { document.documentElement.classList.add("dark"); } [cite: 4]
        else { document.documentElement.classList.remove("dark"); }
      })();
    </script>

    <script define:vars={{ postsData, POSTS_PER_PAGE }}>
      document.addEventListener("DOMContentLoaded", function () {
        // En Astro, define:vars ya convierte el objeto a JSON por ti
        const allPosts = postsData; 
        const postsPerPage = POSTS_PER_PAGE;
        const totalPosts = allPosts.length;
        const totalPages = Math.ceil(totalPosts / postsPerPage);

        function getCurrentPage() {
          const urlParams = new URLSearchParams(window.location.search); [cite: 8]
          const page = urlParams.get("page");
          return page ? parseInt(page, 10) : 1;
        }

        function getPageUrl(page) {
          return page === 1 ? "/parcial01/" : `/parcial01/?page=${page}`;
        }

        function renderPosts(page) {
          const currentPage = Math.max(1, Math.min(page, totalPages)); [cite: 9]
          const startIndex = (currentPage - 1) * postsPerPage;
          const endIndex = startIndex + postsPerPage;
          const postsToShow = allPosts.slice(startIndex, endIndex);
          const postsContainer = document.getElementById("posts-container"); [cite: 10]
          
          if (!postsContainer) return;

          postsContainer.innerHTML = postsToShow
            .map(
              (post) => `
            <a href="${post.href}" class="group relative p-[1px] rounded-2xl transition-all duration-300">
              <div class="absolute inset-0 bg-gradient-to-r from-orange-500/0 via-orange-500/40 to-orange-500/0 opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-500 rounded-2xl"></div>
              
              <div class="relative h-full flex flex-col p-6 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-700 bg-transparent hover:border-orange-500/50 transition-colors duration-300">
                <h2 class="text-lg font-bold mb-4 text-neutral-900 dark:text-neutral-100 min-h-[3.5rem] line-clamp-2">
                  ${post.title}
                </h2>

                <div class="relative h-40 w-full mb-5 overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800">
                  <img
                    src="${post.image}"
                    alt="${post.title}"
                    class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
                  />
                </div>

                <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6 line-clamp-3">
                  ${post.description}
                </p>

                <div class="mt-auto pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-[11px] uppercase tracking-wider font-semibold text-neutral-500">
                  <span>${post.date}</span>
                  <span class="flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    ${post.readTime}
                  </span>
                </div>
              </div>
            </a>
          `
            )
            .join("");
        }

        function renderPagination(page) {
          const currentPage = Math.max(1, Math.min(page, totalPages)); [cite: 37]
          const paginationContainer = document.getElementById("pagination-container"); [cite: 38]
          if (!paginationContainer || totalPages <= 1) return;

          let paginationHTML = '<div class="flex justify-center items-center gap-4 mt-16">';
          
          paginationHTML += currentPage > 1 
            ? `<a href="${getPageUrl(currentPage - 1)}" class="text-sm font-bold text-neutral-500 hover:text-orange-500 transition-colors">← PREV</a>` [cite: 41, 42]
            : `<span class="text-sm font-bold text-neutral-300 dark:text-neutral-700 cursor-not-allowed">← PREV</span>`; [cite: 43]

          for (let i = 1; i <= totalPages; i++) {
            const isCurrent = i === currentPage; [cite: 45]
            paginationHTML += `
              <a href="${getPageUrl(i)}" class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold transition-all ${
                isCurrent ? "bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900" : "text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-800"
              }">${i}</a>
            `;
          }

          paginationHTML += currentPage < totalPages 
            ? `<a href="${getPageUrl(currentPage + 1)}" class="text-sm font-bold text-neutral-500 hover:text-orange-500 transition-colors">NEXT →</a>` [cite: 49, 50]
            : `<span class="text-sm font-bold text-neutral-300 dark:text-neutral-700 cursor-not-allowed">NEXT →</span>`; [cite: 51]

          paginationHTML += "</div>";
          paginationContainer.innerHTML = paginationHTML;
        }

        function handlePaginationClick(e) {
          const target = e.target.closest("a"); [cite: 54]
          if (!target || !target.href || !target.href.includes("?page=")) return; [cite: 55]

          e.preventDefault();
          const url = new URL(target.href); [cite: 56]
          const page = parseInt(url.searchParams.get("page") || "1", 10); [cite: 57]
          
          window.history.pushState({ page }, "", target.href);
          renderPosts(page);
          renderPagination(page);
          window.scrollTo({ top: 0, behavior: "smooth" });
        }

        const initialPage = getCurrentPage(); [cite: 58]
        renderPosts(initialPage); [cite: 59]
        renderPagination(initialPage);

        document.getElementById("pagination-container")?.addEventListener("click", handlePaginationClick); [cite: 61]
      });
    </script>

    <style>
      html, body { margin: 0; padding: 0; height: 100%; overflow-x: hidden; } [cite: 63]
      body { display: flex; flex-direction: column; min-height: 100vh; } [cite: 64]
      main { flex: 1; } [cite: 65]
      .dot-hexagon-light {
        background-image: radial-gradient(circle, #80808030 1px, transparent 1px), radial-gradient(circle, #80808030 1px, transparent 1px);
        background-size: 24px 41.57px; background-position: 0 0, 12px 20.78px; [cite: 67]
      }
      .dot-hexagon-dark {
        background-image: radial-gradient(circle, #ffffff20 1px, transparent 1px), radial-gradient(circle, #ffffff20 1px, transparent 1px);
        background-size: 24px 41.57px; background-position: 0 0, 12px 20.78px; [cite: 69]
      }
    </style>
  </head>

  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(255,255,255,0.8)_80%,white_100%)] dark:bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(23,23,23,0.8)_80%,rgb(23,23,23)_100%)] -z-10"></div>
    </div>

    <main class="relative z-10 flex flex-col">
      <Navigation />
      
      <section class="w-full max-w-7xl mx-auto mt-24 px-6 pb-20">
        <div class="flex flex-col mb-16">
          <h2 class="text-3xl font-black tracking-tighter text-neutral-900 dark:text-neutral-100 sm:text-5xl">
            Actividades Parcial I
          </h2>
          <div class="h-1 w-20 bg-orange-500 mt-4"></div>
        </div>

        <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          </div>

        <div id="pagination-container"></div>
      </section>
    </main>

    <Footer />
  </body>
</html>