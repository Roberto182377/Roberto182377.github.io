                  <tr><td>Restricción de software y bloqueo de almacenamiento USB</td><td>En Monitoreo</td><td>92% de cumplimiento por excepciones temporales</td></tr>
                  <tr><td>Resguardo de sellos institucionales bajo llave en oficina</td><td>Auditado</td><td>100% de cumplimiento en revisiones sorpresa</td></tr>
                </tbody>
