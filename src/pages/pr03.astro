---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Índice lateral simplificado para el manejo de los estados activos
const menuLateral = [
  { id: "sec-1", numero: "I", titulo: "Alcance del SGSI" },
  { id: "sec-2", numero: "II", titulo: "Referencias Normativas" },
  { id: "sec-3", numero: "III", titulo: "Términos y Definiciones" },
  { id: "sec-4", numero: "IV", titulo: "Contexto de la Organización" },
  { id: "sec-5", numero: "V", titulo: "Liderazgo y Políticas" },
  { id: "sec-6", numero: "VI", titulo: "Planificación de Riesgos" },
  { id: "sec-7", numero: "VII", titulo: "Soporte" },
  { id: "sec-8", numero: "VIII", titulo: "Operación" },
  { id: "sec-9", numero: "IX", titulo: "Evaluación del Desempeño" },
  { id: "sec-10", numero: "X", titulo: "Mejora" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ISO 27001 SEER | Portafolio</title>
    <style>
      /* Variables Base: MODO OSCURO POR DEFECTO */
      :root {
        --bg-main: #0a0a0a;
        --bg-card: #141414;
        --bg-hover: #1e1e1e;
        --text-title: #ededed;
        --text-body: #d1d1d1;
        --text-muted: #888888;
        --border-ui: rgba(255, 255, 255, 0.08);
        --accent-color: #2563eb;
        --accent-glow: rgba(37, 99, 235, 0.1);
        --dot-color: rgba(255, 255, 255, 0.15);
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
      }

      /* INTERRUPTOR DE MODO CLARO */
      :global(html:not(.dark)), :global(html.light), :global(html[data-theme="light"]) {
        --bg-main: #ffffff;
        --bg-card: #f8f9fa;
        --bg-hover: #f1f3f5;
        --text-title: #111111;
        --text-body: #333333;
        --text-muted: #6c757d;
        --border-ui: #e9ecef;
        --accent-color: #2563eb;
        --accent-glow: rgba(37, 99, 235, 0.08);
        --dot-color: rgba(0, 0, 0, 0.08);
      }

      body {
        margin: 0;
        background-color: var(--bg-main);
        color: var(--text-body);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-image: 
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px),
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        background-attachment: fixed;
        transition: background-color 0.4s ease, color 0.4s ease;
      }

      .container {
        max-width: 1350px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
      }

      header { text-align: center; margin-bottom: 2.5rem; }
      
      h1 { 
        font-size: 2.8rem; 
        font-weight: 800; 
        letter-spacing: -0.03em; 
        color: var(--text-title);
        margin: 0 0 0.5rem 0; 
      }

      .subtitle {
        color: var(--text-muted);
        font-size: 1.15rem;
        max-width: 700px;
        margin: 0 auto;
      }

      /* ÁREA GLOBAL DE ACCIONES (TOP) */
      .global-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 3.5rem;
      }

      .btn-download {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--bg-card);
        color: var(--text-title);
        border: 1px solid var(--border-ui);
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }

      .btn-download:hover {
        background: var(--bg-hover);
        border-color: var(--accent-color);
        transform: translateY(-2px);
      }

      /* LAYOUT PRINCIPAL */
      .dashboard-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-bottom: 4rem;
      }

      /* SIDEBAR */
      .sidebar {
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 12px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: sticky;
        top: 2rem;
      }

      .sidebar-header {
        padding: 1.2rem;
        border-bottom: 1px solid var(--border-ui);
        font-weight: 700;
        color: var(--text-title);
        font-size: 0.95rem;
        background: rgba(0,0,0,0.02);
      }

      .clause-btn {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--border-ui);
        color: var(--text-body);
        padding: 1.1rem 1.2rem;
        text-align: left;
        font-weight: 500; 
        font-size: 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
      }

      .clause-btn:last-child { border-bottom: none; }
      .clause-btn .num { font-weight: 700; color: var(--text-muted); width: 24px; }
      .clause-btn:hover { background-color: var(--bg-hover); color: var(--text-title); padding-left: 1.5rem; }
      .clause-btn.active { background-color: var(--bg-hover); color: var(--accent-color); padding-left: 1.5rem; font-weight: 700; }
      
      .clause-btn::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
        background-color: var(--accent-color); transform: scaleY(0); transition: transform 0.3s ease;
      }
      .clause-btn.active::before { transform: scaleY(1); }

      /* PANEL DERECHO (VIEWER DE HTML LIBRE) */
      .viewer {
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 14px;
        padding: 3rem;
        min-height: 600px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
      }

      .clause-content { display: none; }
      .clause-content.active { display: block; animation: fadeIn 0.4s ease forwards; }

      @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

      /* ESTILOS INTERNOS DE CONTENIDO */
      .content-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.2rem;
        border-bottom: 1px solid var(--border-ui);
      }

      .content-header h2 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-title);
        margin: 0 0 0.4rem 0;
      }

      .content-header p {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin: 0;
      }

      .html-body { line-height: 1.7; font-size: 1.05rem; color: var(--text-body); }
      .html-body h3 { color: var(--text-title); font-size: 1.3rem; margin-top: 2rem; margin-bottom: 1rem; font-weight: 700; }
      .html-body p { margin: 0 0 1.2rem 0; }

      /* GRIDS Y DISTRIBUCIONES */
      .grid-2-cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: start;
        margin-bottom: 1.5rem;
      }

      .box-card {
        padding: 1.2rem;
        background: var(--bg-hover);
        border-radius: 8px;
        border-left: 4px solid var(--border-ui);
        font-size: 0.95rem;
      }
      .box-card.border-accent { border-color: var(--accent-color); }
      .box-card.border-red { border-color: var(--danger); }
      .box-card.border-warning { border-color: var(--warning); }

      /* ENTORNO DE IMÁGENES Y PLACEHOLDERS */
      .image-container {
        width: 100%;
        background: var(--bg-hover);
        border: 1px dashed var(--border-ui);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 500;
        min-height: 220px;
        margin: 1.5rem 0;
      }
      .image-container.large { min-height: 350px; margin-top: 0; margin-bottom: 2rem; }
      .image-container.step-img { min-height: 180px; margin: 1rem 0 2rem 0; }

      /* TABLAS DE ALTO RENDIMIENTO */
      .table-responsive {
        max-height: 480px;
        overflow-y: auto;
        border: 1px solid var(--border-ui);
        border-radius: 8px;
        margin: 1.5rem 0;
        background: var(--bg-main);
      }

      .table-responsive::-webkit-scrollbar { width: 6px; height: 6px; }
      .table-responsive::-webkit-scrollbar-track { background: var(--bg-hover); }
      .table-responsive::-webkit-scrollbar-thumb { background: var(--border-ui); border-radius: 4px; }

      .styled-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left; }
      .styled-table thead { position: sticky; top: 0; background: var(--bg-hover); z-index: 5; }
      .styled-table th { color: var(--text-title); padding: 1rem; font-weight: 700; border-bottom: 2px solid var(--border-ui); }
      .styled-table td { padding: 0.9rem 1rem; border-bottom: 1px solid var(--border-ui); }
      .styled-table tbody tr:hover { background-color: rgba(255, 255, 255, 0.01); }

      .badge-cia {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-ui);
      }

      /* SECCIÓN DOCUMENTAL Y REFERENCIAS FINALES */
      .document-viewer-section {
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 12px;
        padding: 2.5rem;
        margin-top: 3rem;
      }

      .iframe-container {
        width: 100%;
        border: 1px solid var(--border-ui);
        border-radius: 8px;
        overflow: hidden;
        background: #1e1e1e;
        margin-top: 1.5rem;
      }

      .references-section {
        border-top: 1px solid var(--border-ui);
        margin-top: 4rem;
        padding-top: 2.5rem;
      }

      .references-list {
        padding-left: 1.2rem;
        line-height: 1.8;
        color: var(--text-muted);
        font-size: 0.95rem;
      }
      .references-list li { margin-bottom: 0.8rem; }

      @media (max-width: 950px) {
        .dashboard-layout { grid-template-columns: 1fr; }
        .sidebar { position: static; max-height: 280px; overflow-y: auto; }
        .grid-2-cols { grid-template-columns: 1fr; gap: 1rem; }
      }
    </style>
  </head>
  <body>
    <Navigation />
    
    <main class="container">
      <header>
        <h1>Implementación de la Norma ISO 27001:2022 en el SEER</h1>
        <p class="subtitle">Auditoría de Seguridad de la Información, Evaluación del Contexto y Tratamiento de Riesgos en Recursos Humanos</p>
      </header>

      <div class="global-actions">
        <a href="/assets/pr03/PR03-Equipo1_SI.pdf" download class="btn-download">
          Documento de Investigación (PDF)
        </a>
        <a href="/assets/pr03/COMUNICADO DE SEGURIDAD Incidente de Phishing en Office 365 (SEER).png" download class="btn-download">
          Comunicado de Seguridad (png)
        </a>
      </div>

      <div class="dashboard-layout">
        
        <aside class="sidebar">
          <div class="sidebar-header">Cláusulas ISO 27001</div>
          {menuLateral.map((sec, index) => (
            <button class={`clause-btn ${index === 0 ? 'active' : ''}`} data-target={sec.id}>
              <span class="num">{sec.numero}</span>
              <span class="title">{sec.titulo}</span>
            </button>
          ))}
        </aside>

        <section class="viewer html-body">
          
          <div id="sec-1" class="clause-content active">
            <div class="content-header">
              <h2>Cláusula I: Alcance del SGSI</h2>
              <p>Fronteras y aplicabilidad del Sistema de Gestión de Seguridad de la Información.</p>
            </div>
            <div class="grid-2-cols">
              <div>
                <h3>Contexto</h3>
                <p>El Sistema Educativo Estatal Regular (SEER) gestiona datos sumamente sensibles de personal docente y administrativo en el estado de San Luis Potosí, lo que exige un marco formal de resguardo normativo.</p>
              </div>
              <div class="image-container" style="margin:0;">
                <img src="/assets/pr03/logo-seer.png" alt="SEER">
              </div>
            </div>
            <h3>Delimitación</h3>
            <p>El perímetro del SGSI se restringe de forma exclusiva a la infraestructura tecnológica, bases de datos lógicas y archivos documentales físicos pertenecientes al Departamento de Recursos Humanos de la institución.</p>
            <h3>Justificación</h3>
            <p>Se prioriza este departamento debido a la alta concentración de datos de identificación personal (PII), transacciones bancarias de nómina y expedientes laborales, cuya vulneración comprometería la continuidad operativa institucional.</p>
          </div>

          <div id="sec-2" class="clause-content">
            <div class="content-header">
              <h2>Cláusula II: Referencias Normativas</h2>
              <p>Estándares y guías internacionales de cumplimiento obligatorio.</p>
            </div>
            <p>Para la correcta implementación del SGSI en el SEER, se aplican las siguientes normativas de la familia ISO/IEC 27000, utilizadas como guías rectoras y de cumplimiento obligatorio en el diseño de los controles:</p>
            
            <div class="box-card border-accent" style="margin-bottom: 1rem;">
              <strong>1) ISO/IEC 27001:2022 (Information security, cybersecurity and privacy protection - Information security management systems - Requirements)</strong>
              <p style="margin: 0.3rem 0 0 0; font-size:0.95rem;">Norma base certificable. Se utiliza para establecer los requisitos formales del SGSI en el SEER, delimitar el alcance y definir el ciclo de mejora continua.</p>
            </div>

            <div class="box-card border-accent" style="margin-bottom: 1rem;">
              <strong>2) ISO/IEC 27002:2022 (Information security controls)</strong>
              <p style="margin: 0.3rem 0 0 0; font-size:0.95rem;">Catálogo de controles de seguridad. Se utiliza para seleccionar las buenas prácticas (controles preventivos, detectivos y correctivos) aplicables a los activos de Recursos Humanos.</p>
            </div>

            <div class="box-card border-accent" style="margin-bottom: 1rem;">
              <strong>3) ISO/IEC 27005:2018 (Information security risk management)</strong>
              <p style="margin: 0.3rem 0 0 0; font-size:0.95rem;">Se emplea como metodología estructurada para identificar, evaluar y tratar los riesgos (amenazas y vulnerabilidades) específicos del departamento de Recursos Humanos.</p>
            </div>

            <div class="box-card border-accent" style="margin-bottom: 1rem;">
              <strong>4) ISO/IEC 27017:2015 (Code of practice for information security controls based on ISO/IEC 27002 for cloud services)</strong>
              <p style="margin: 0.3rem 0 0 0; font-size:0.95rem;">Aplicada específicamente para regular el uso seguro de Microsoft Office 365 y OneDrive por parte de los administrativos.</p>
            </div>

            <div class="box-card border-accent">
              <strong>5) ISO/IEC 27018:2019 (Code of practice for protection of personally identifiable information (PII) in public clouds)</strong>
              <p style="margin: 0.3rem 0 0 0; font-size:0.95rem;">Esencial para garantizar que los datos personales de los docentes subidos a la nube cumplan con parámetros de privacidad.</p>
            </div>
          </div>

          <div id="sec-3" class="clause-content">
            <div class="content-header">
              <h2>Cláusula III: Términos y Definiciones</h2>
              <p>Vocabulario estandarizado bajo los criterios de auditoría de la norma base.</p>
            </div>
            <div class="table-responsive">
              <table class="styled-table">
                <thead>
                  <tr><th>Término</th><th>Definición Breve y Concisa</th></tr>
                </thead>
                <tbody>
                  <tr><td><strong>Acción Preventiva</strong></td><td>Medida proactiva orientada a mitigar potenciales no conformidades antes de su ocurrencia.</td></tr>
                  <tr><td><strong>Activo (Asset)</strong></td><td>Cualquier elemento o sistema físico, lógico o humano con valor explícito para la institución.</td></tr>
                  <tr><td><strong>Amenaza (Threat)</strong></td><td>Causa potencial de un incidente adverso capaz de dañar los activos del SEER.</td></tr>
                  <tr><td><strong>Análisis de Riesgos</strong></td><td>Proceso sistemático orientado a comprender la naturaleza y nivel de riesgo de un vector de ataque.</td></tr>
                  <tr><td><strong>Checklist</strong></td><td>Herramienta documental del auditor para asegurar la continuidad, profundidad y objetividad de la evaluación.</td></tr>
                  <tr><td><strong>Identificación de Riesgos</strong></td><td>Proceso para encontrar, reconocer y clasificar fuentes de riesgo junto con sus causas y consecuencias.</td></tr>
                  <tr><td><strong>Inventario de Activos</strong></td><td>Registro formal de recursos protegidos bajo el alcance del SGSI del departamento de Recursos Humanos.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div id="sec-4" class="clause-content">
            <div class="content-header">
              <h2>Cláusula IV: Contexto de la Organización</h2>
              <p>Inventario completo de los 40 activos críticos mapeados en el alcance de la auditoría.</p>
            </div>
            <div class="table-responsive">
              <table class="styled-table">
                <thead>
                  <tr><th>ID</th><th>Activo</th><th>Ubicación</th><th>Tríada CIA</th><th>Justificación del Riesgo</th></tr>
                </thead>
                <tbody>
                  <tr><td>ACT-01</td><td>Escuelas del S.E.E.R</td><td>Interno</td><td>C-Baja, I-Baja, D-Alta</td><td>Disponibilidad de servicios de control escolar descentralizados.</td></tr>
                  <tr><td>ACT-02</td><td>Computadoras en salones</td><td>Interno</td><td>C-Media, I-Media, D-Alta</td><td>Punto de acceso a red desprotegido y vector de malware.</td></tr>
                  <tr><td>ACT-03</td><td>Servidores escuela</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Almacenamiento crítico, riesgo de fuga de datos de identificación.</td></tr>
                  <tr><td>ACT-04</td><td>Impresoras Empresariales</td><td>Interno</td><td>C-Media, I-Baja, D-Media</td><td>Riesgo de fuga de información por documentos impresos huérfanos.</td></tr>
                  <tr><td>ACT-05</td><td>Gestor base de datos</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Corrupción o secuestro de registros académicos históricos.</td></tr>
                  <tr><td>ACT-06</td><td>Datos alumno</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Fuga de datos de menores y expedientes de control escolar.</td></tr>
                  <tr><td>ACT-07</td><td>Expedientes personal</td><td>Interno</td><td>C-Alta, I-Alta, D-Media</td><td>Acceso no autorizado a registros financieros y médicos de empleados.</td></tr>
                  <tr><td>ACT-08</td><td>Contratos empleado</td><td>Interno</td><td>C-Alta, I-Alta, D-Baja</td><td>Filtración de términos laborales o vulneración de confidencialidad.</td></tr>
                  <tr><td>ACT-09</td><td>Sistemas de control escolar</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Alteración maliciosa de calificaciones y estatus académico.</td></tr>
                  <tr><td>ACT-10</td><td>Respaldos de BD</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Destrucción o encriptación por ransomware sin almacenamiento alterno.</td></tr>
                  <tr><td>ACT-11</td><td>Redes locales e inalámbricas</td><td>Interno</td><td>C-Media, I-Alta, D-Alta</td><td>Intercepción de tráfico de red interna por falta de segmentación.</td></tr>
                  <tr><td>ACT-12</td><td>Material de oficina</td><td>Interno</td><td>C-Baja, I-Media, D-Baja</td><td>Falsificación de documentos mediante uso indebido de sellos físicos.</td></tr>
                  <tr><td>ACT-13</td><td>Libros/Manuales proc.</td><td>Interno</td><td>C-Media, I-Media, D-Baja</td><td>Pérdida de continuidad por ausencia de manuales operativos documentados.</td></tr>
                  <tr><td>ACT-14</td><td>Infraestructura física</td><td>Interno</td><td>C-Baja, I-Baja, D-Alta</td><td>Ingreso no autorizado al site o racks debido a carencia de control biométrico.</td></tr>
                  <tr><td>ACT-15</td><td>Políticas control escolar</td><td>Interno</td><td>C-Baja, I-Alta, D-Baja</td><td>Incumplimiento normativo por falta de actualización ante leyes estatales.</td></tr>
                  <tr><td>ACT-16</td><td>Software institucional</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Compromiso total de los flujos de trabajo administrativos automatizados.</td></tr>
                  <tr><td>ACT-17</td><td>Protocolos de seguridad</td><td>Interno</td><td>C-Alta, I-Alta, D-Media</td><td>Falta de aplicación operativa de políticas de control de acceso lógico.</td></tr>
                  <tr><td>ACT-18</td><td>Manuales normatividad</td><td>Interno</td><td>C-Baja, I-Media, D-Baja</td><td>Alineación deficiente ante auditorías externas de gobierno.</td></tr>
                  <tr><td>ACT-19</td><td>Capacitación personal</td><td>Interno</td><td>C-Baja, I-Media, D-Baja</td><td>Vulnerabilidad ante ingeniería social por desconocimiento técnico.</td></tr>
                  <tr><td>ACT-20</td><td>Conocimiento administrativo</td><td>Interno</td><td>C-Media, I-Baja, D-Media</td><td>Fuga de experiencia institucional (know-how) tras la rotación de personal.</td></tr>
                  <tr><td>ACT-21</td><td>Licencia Office 365</td><td>Externo</td><td>C-Alta, I-Alta, D-Alta</td><td>Secuestro de sesiones y fuga de PII alojada en la nube corporativa.</td></tr>
                  <tr><td>ACT-22</td><td>Certificaciones</td><td>Externo</td><td>C-Baja, I-Alta, D-Baja</td><td>Falsificación o alteración de validez oficial en plataformas externas.</td></tr>
                  <tr><td>ACT-23</td><td>Plataformas Normativa Fed.</td><td>Externo</td><td>C-Baja, I-Alta, D-Alta</td><td>Pérdida del enlace o sincronización de datos con la federación.</td></tr>
                  <tr><td>ACT-24</td><td>Regulaciones Est/Fed</td><td>Externo</td><td>C-Baja, I-Media, D-Baja</td><td>Sanciones administrativas por desfase ante nuevas leyes de privacidad.</td></tr>
