---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Solo guardamos los datos del menú lateral aquí para mantenerlo limpio.
const menuLateral = [
  { id: "sec-1", numero: "I", titulo: "Alcance del SGSI", icono: "🎯" },
  { id: "sec-2", numero: "II", titulo: "Referencias Normativas", icono: "📚" },
  { id: "sec-3", numero: "III", titulo: "Términos y Definiciones", icono: "📖" },
  { id: "sec-4", numero: "IV", titulo: "Contexto de la Organización", icono: "🏢" },
  { id: "sec-5", numero: "V", titulo: "Liderazgo y Políticas", icono: "👑" },
  { id: "sec-6", numero: "VI", titulo: "Planificación de Riesgos", icono: "⚠️" },
  { id: "sec-7", numero: "VII", titulo: "Soporte y Concientización", icono: "🤝" },
  { id: "sec-8", numero: "VIII", titulo: "Operación Técnica", icono: "⚙️" },
  { id: "sec-9", numero: "IX", titulo: "Evaluación del Desempeño", icono: "📊" },
  { id: "sec-10", numero: "X", titulo: "Mejora Continua", icono: "🚀" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ISO 27001 SEER | Portafolio</title>
    <style>
      /* Variables y MODO OSCURO (Mismo funcionamiento de tu portafolio) */
      :root {
        --bg-main: #0a0a0a;
        --bg-card: #141414;
        --bg-hover: #1e1e1e;
        --text-title: #ededed;
        --text-body: #d1d1d1;
        --text-muted: #888888;
        --border-ui: rgba(255, 255, 255, 0.08);
        --accent-color: #2563eb;
        --accent-glow: rgba(37, 99, 235, 0.1);
        --dot-color: rgba(255, 255, 255, 0.15);
      }

      :global(html:not(.dark)), :global(html.light), :global(html[data-theme="light"]) {
        --bg-main: #ffffff;
        --bg-card: #f8f9fa;
        --bg-hover: #f1f3f5;
        --text-title: #111111;
        --text-body: #333333;
        --text-muted: #6c757d;
        --border-ui: #e9ecef;
        --accent-color: #2563eb;
        --accent-glow: rgba(37, 99, 235, 0.08);
        --dot-color: rgba(0, 0, 0, 0.08);
      }

      body {
        margin: 0; background-color: var(--bg-main); color: var(--text-body);
        font-family: 'Inter', system-ui, sans-serif;
        background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px), radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
        background-size: 24px 41.57px; background-position: 0 0, 12px 20.78px; background-attachment: fixed;
        transition: background-color 0.4s ease, color 0.4s ease;
      }

      .container { max-width: 1350px; margin: 0 auto; padding: 4rem 1.5rem; }
      header { text-align: center; margin-bottom: 4rem; }
      h1 { font-size: 2.8rem; font-weight: 800; color: var(--text-title); margin: 0 0 0.5rem 0; }
      .subtitle { color: var(--text-muted); font-size: 1.15rem; max-width: 600px; margin: 0 auto; }

      .dashboard-layout { display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: start; }

      /* SIDEBAR */
      .sidebar {
        display: flex; flex-direction: column; background: var(--bg-card);
        border: 1px solid var(--border-ui); border-radius: 12px;
        position: sticky; top: 2rem;
      }
      .sidebar-header { padding: 1.2rem; border-bottom: 1px solid var(--border-ui); font-weight: 700; color: var(--text-title); background: rgba(0,0,0,0.02); }
      .clause-btn {
        background: transparent; border: none; border-bottom: 1px solid var(--border-ui);
        color: var(--text-body); padding: 1rem 1.2rem; text-align: left; font-weight: 500; font-size: 0.95rem;
        cursor: pointer; display: flex; align-items: center; gap: 0.8rem; transition: all 0.3s ease; position: relative;
      }
      .clause-btn:last-child { border-bottom: none; }
      .clause-btn:hover { background-color: var(--bg-hover); color: var(--text-title); padding-left: 1.6rem; }
      .clause-btn.active { background-color: var(--bg-hover); color: var(--accent-color); padding-left: 1.6rem; font-weight: 700; }
      .clause-btn::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: var(--accent-color); transform: scaleY(0); transition: transform 0.3s ease; }
      .clause-btn.active::before { transform: scaleY(1); }

      /* VIEWER PRINCIPAL */
      .viewer {
        background: var(--bg-card); border: 1px solid var(--border-ui);
        border-radius: 14px; padding: 3rem; min-height: 700px;
      }
      .clause-content { display: none; animation: fadeIn 0.4s ease forwards; }
      .clause-content.active { display: block; }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

      /* NUEVOS ESTILOS PARA CONTENIDO LIBRE (Imágenes, Grids, Botones) */
      .content-header { border-bottom: 1px solid var(--border-ui); padding-bottom: 1rem; margin-bottom: 2rem; }
      .content-header h2 { color: var(--text-title); font-size: 2rem; margin: 0; display: flex; align-items: center; gap: 10px;}
      .content-header p { color: var(--text-muted); font-size: 1.1rem; }

      /* Grid para texto e imagen lado a lado */
      .content-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; align-items: start; margin-bottom: 2rem; }
      @media (max-width: 900px) { .content-grid { grid-template-columns: 1fr; } }
      
      .content-img { width: 100%; border-radius: 8px; border: 1px solid var(--border-ui); box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
      
      /* Botones de acción (PDFs, Docs) */
      .btn-action {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--accent-color); color: white; padding: 0.8rem 1.5rem;
        border-radius: 8px; text-decoration: none; font-weight: 600;
        transition: transform 0.2s, background 0.2s;
      }
      .btn-action:hover { transform: translateY(-2px); background: #1d4ed8; }
      .btn-action.secondary { background: var(--bg-hover); color: var(--text-title); border: 1px solid var(--border-ui); }
      .btn-action.secondary:hover { background: var(--border-ui); }

      /* Elementos HTML Comunes */
      .html-body h3 { color: var(--text-title); font-size: 1.4rem; border-left: 4px solid var(--accent-color); padding-left: 10px; margin-top: 2rem;}
      .html-body p { line-height: 1.7; font-size: 1.05rem; }
      .alert-box { padding: 1.2rem; background: var(--accent-glow); border-left: 4px solid var(--accent-color); border-radius: 0 8px 8px 0; margin: 1.5rem 0; }
      
      /* Tablas */
      .table-responsive { overflow-x: auto; max-height: 500px; border: 1px solid var(--border-ui); border-radius: 8px; margin-top: 1rem; }
      .styled-table { width: 100%; border-collapse: collapse; text-align: left; }
      .styled-table th { background: var(--bg-hover); color: var(--text-title); padding: 1rem; position: sticky; top: 0; }
      .styled-table td { padding: 1rem; border-bottom: 1px solid var(--border-ui); }
    </style>
  </head>
  <body>
    <Navigation />
    
    <main class="container">
      <header>
        <h1>Implementación ISO 27001:2022</h1>
        <p class="subtitle">Auditoría y Gestión de Riesgos en el Sistema Educativo Estatal Regular (SEER).</p>
      </header>

      <div class="dashboard-layout">
        
        <aside class="sidebar">
          <div class="sidebar-header">Cláusulas del Proyecto</div>
          {menuLateral.map((sec, index) => (
            <button class={`clause-btn ${index === 0 ? 'active' : ''}`} data-target={sec.id}>
              <span class="num">{sec.numero}.</span><span class="icon">{sec.icono}</span><span class="title">{sec.titulo}</span>
            </button>
          ))}
        </aside>

        <section class="viewer html-body">
          
          <div id="sec-1" class="clause-content active">
            <div class="content-header">
              <h2>🎯 I. Alcance del SGSI</h2>
              <p>Definición de las fronteras y aplicabilidad del Sistema de Gestión.</p>
            </div>
            
            <div class="content-grid">
              <div>
                <h3>Delimitación del Proyecto</h3>
                <p>El proyecto establece el perímetro de seguridad enfocado exclusivamente en el <strong>Departamento de Recursos Humanos del SEER</strong>.</p>
                <div class="alert-box">
                  <strong>Objetivo Crítico:</strong> Proteger datos personales, expedientes laborales y nóminas de amenazas internas y externas.
                </div>
                <div style="display: flex; gap: 10px; margin-top: 1.5rem;">
                  <a href="/docs/PR03-Equipo1.pdf" download class="btn-action">📄 Descargar Investigación (PDF)</a>
                  <a href="#" class="btn-action secondary">📊 Ver Anexos</a>
                </div>
              </div>
              <div>
                <img src="https://placehold.co/600x400/151515/ededed?text=Diagrama+de+Alcance" alt="Diagrama de Alcance" class="content-img" />
              </div>
            </div>
          </div>

          <div id="sec-2" class="clause-content">
            <div class="content-header"><h2>📚 II. Referencias Normativas</h2><p>Estándares internacionales aplicados.</p></div>
            <p>Para asegurar el rigor corporativo, el SGSI del SEER se construyó sobre 5 pilares normativos:</p>
            <ul>
              <li><strong>ISO/IEC 27001:2022:</strong> Requisitos formales del SGSI.</li>
              <li><strong>ISO/IEC 27002:2022:</strong> Catálogo de controles técnicos y organizacionales.</li>
              <li><strong>ISO/IEC 27005:2018:</strong> Gestión de riesgos de seguridad.</li>
              <li><strong>ISO/IEC 27017 & 27018:</strong> Controles para servicios en la nube (Office 365) y protección de PII.</li>
            </ul>
          </div>

          <div id="sec-3" class="clause-content">
            <div class="content-header"><h2>📖 III. Términos y Definiciones</h2><p>Estandarización del vocabulario (Guía ISO 73:2009).</p></div>
            <h3>Glosario Estratégico</h3>
            <div class="table-responsive">
              <table class="styled-table">
                <thead><tr><th>Término</th><th>Definición en el contexto del SEER</th></tr></thead>
                <tbody>
                  <tr><td><strong>Activo</strong></td><td>Cualquier información, sistema o persona con valor para la organización.</td></tr>
                  <tr><td><strong>Amenaza</strong></td><td>Causa potencial de un incidente no deseado.</td></tr>
                  <tr><td><strong>Vulnerabilidad</strong></td><td>Debilidad en un activo que puede ser explotada.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div id="sec-4" class="clause-content">
            <div class="content-header"><h2>🏢 IV. Contexto de la Organización</h2><p>Mapeo de los 40 activos críticos.</p></div>
            
            <div class="content-grid">
              <div>
                <p>Se realizó una clasificación rigurosa evaluando el impacto de cada activo en la <strong>Tríada CIA</strong> (Confidencialidad, Integridad y Disponibilidad).</p>
              </div>
              <div>
                <img src="https://placehold.co/600x300/151515/ededed?text=Grafico+de+Activos" alt="Gráfico de Activos" class="content-img" />
              </div>
            </div>

            <h3>Inventario de Activos (Extracto)</h3>
            <div class="table-responsive">
              <table class="styled-table">
                <thead>
                  <tr><th>ID</th><th>Activo</th><th>Tipo</th><th>Tríada CIA</th><th>Justificación</th></tr>
                </thead>
                <tbody>
                  <tr><td>ACT-03</td><td>Servidores escuela</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Fuga de PII (Alumnos/Maestros).</td></tr>
                  <tr><td>ACT-05</td><td>Gestor base de datos</td><td>Interno</td><td>C-Alta, I-Alta, D-Alta</td><td>Corrupción de registros.</td></tr>
                  <tr><td>ACT-21</td><td>Licencia Office 365</td><td>Externo</td><td>C-Alta, I-Alta, D-Alta</td><td>Secuestro de sesión en nube.</td></tr>
                  <tr><td>ACT-37</td><td>Plataformas SIGED</td><td>Externo</td><td>C-Alta, I-Alta, D-Alta</td><td>Integridad de expediente federal.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div id="sec-5" class="clause-content">
            <div class="content-header"><h2>👑 V. Liderazgo y Políticas</h2><p>Estructura de gobernanza.</p></div>
            <h3>Políticas Funcionales</h3>
            <div class="table-responsive">
              <table class="styled-table">
                <thead><tr><th>Política</th><th>Directriz</th><th>Procedimiento</th></tr></thead>
                <tbody>
                  <tr><td>1. Control de Acceso</td><td>Contraseñas complejas (12+ caracteres).</td><td>Cambio obligatorio cada 90 días.</td></tr>
                  <tr><td>4. Seguridad Física</td><td>"Escritorio Limpio" al final de la jornada.</td><td>Archiveros con llave obligatoria.</td></tr>
                  <tr><td>Externo: Cloud</td><td>Cuentas institucionales obligatorias.</td><td>Uso estricto de 2FA/MFA.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div id="sec-6" class="clause-content"><div class="content-header"><h2>⚠️ VI. Planificación de Riesgos</h2></div><p>Contenido libre aquí...</p></div>
          <div id="sec-7" class="clause-content"><div class="content-header"><h2>🤝 VII. Soporte y Concientización</h2></div><p>Contenido libre aquí...</p></div>
          <div id="sec-8" class="clause-content"><div class="content-header"><h2>⚙️ VIII. Operación Técnica</h2></div><p>Contenido libre aquí...</p></div>
          <div id="sec-9" class="clause-content"><div class="content-header"><h2>📊 IX. Evaluación del Desempeño</h2></div><p>Contenido libre aquí...</p></div>
          <div id="sec-10" class="clause-content"><div class="content-header"><h2>🚀 X. Mejora Continua</h2></div><p>Contenido libre aquí...</p></div>

        </section>
      </div>
    </main>

    <Footer />

    <script is:inline>
      const buttons = document.querySelectorAll('.clause-btn');
      const contents = document.querySelectorAll('.clause-content');

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          if (button.classList.contains('active')) return;
          buttons.forEach(btn => btn.classList.remove('active'));
          contents.forEach(content => content.classList.remove('active'));
          
          button.classList.add('active');
          const targetId = button.getAttribute('data-target');
          document.getElementById(targetId)?.classList.add('active');
        });
      });
    </script>
  </body>
</html>