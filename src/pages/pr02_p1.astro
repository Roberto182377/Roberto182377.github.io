---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Datos de las plataformas (Copiado íntegramente del MD)
const platforms = [
  { name: "Hoxhunt", logo: "/assets/images/posts/pr01-1.png", desc: "Plataforma basada en IA que personaliza las simulaciones según el comportamiento del usuario. Su enfoque es la gamificación y el refuerzo positivo." },
  { name: "Proofpoint (PSAT)", logo: "/assets/images/posts/pr01-2.png", desc: "Utiliza inteligencia de amenazas real para crear simulaciones. Se centra en identificar a los usuarios más atacados (Very Attacked People - VAPs)." },
  { name: "KnowBe4", logo: "/assets/images/posts/pr01-3.png", desc: "Es la plataforma más grande del mercado. Ofrece una biblioteca masiva de contenido educativo y herramientas de simulación altamente personalizables." },
  { name: "Cofense", logo: "/assets/images/posts/pr01-4.png", desc: "Se especializa en la detección y respuesta. Su enfoque principal es convertir a los empleados en una red de sensores de amenazas activa." },
  { name: "Phished", logo: "/assets/images/posts/pr01-5.png", desc: "Utiliza algoritmos de IA para automatizar completamente el entrenamiento, eliminando la necesidad de intervención manual en la creación de campañas." },
  { name: "NINJIO", logo: "/assets/images/posts/pr01-6.png", desc: "Se enfoca en el storytelling mediante episodios de micro-aprendizaje animados basados en brechas de seguridad reales de la última semana." },
  { name: "Mimecast", logo: "/assets/images/posts/pr01-7.png", desc: "Utiliza contenido humorístico y persistente para mejorar la retención de los conceptos de seguridad, integrándose directamente con sus soluciones de seguridad de correo." },
  { name: "Infosec IQ", logo: "/assets/images/posts/pr01-8.png", desc: "Ofrece rutas de aprendizaje personalizadas basadas en el rol del empleado y su nivel de conocimiento previo." }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Análisis comparativo de metodologías de seguridad informática</title>
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        if (savedTheme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
    <style>
      :root { --bg: #ffffff; --text: #171717; --card: #f9f9f9; --accent: #2563eb; --dot: #80808030; --border: #e5e7eb; }
      .dark { --bg: #0a0a0a; --text: #ededed; --card: #151515; --accent: #60a5fa; --dot: #ffffff15; --border: #333333; }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px), radial-gradient(circle, var(--dot) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        background-attachment: fixed;
      }

      .container { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem; }
      
      .section-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2.5rem;
        margin-bottom: 3rem;
      }

      .pdf-link {
        display: inline-flex;
        align-items: center;
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--accent);
        border-radius: 8px;
        transition: 0.2s;
      }

      .pdf-link:hover { background: var(--accent); color: white; }

      h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1.5rem; line-height: 1.2; }
      h2 { font-size: 1.8rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1.5rem; color: var(--accent); }
      h3 { font-size: 1.4rem; font-weight: 600; margin-bottom: 1rem; }

      p { line-height: 1.7; margin-bottom: 1.2rem; opacity: 0.9; }
      ul { margin-bottom: 1.5rem; list-style-type: none; padding-left: 0; }
      li { margin-bottom: 0.8rem; padding-left: 1.5rem; position: relative; }
      li::before { content: "→"; position: absolute; left: 0; color: var(--accent); }

      .platform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .platform-card {
        background: var(--card);
        border: 1px dashed var(--border);
        padding: 1.5rem;
        border-radius: 12px;
        transition: 0.3s;
      }

      .platform-card:hover { border-color: var(--accent); transform: translateY(-3px); }

      .platform-logo {
        height: 50px;
        width: auto;
        margin-bottom: 1rem;
        display: block;
        /* No background here as requested */
      }

      .table-wrapper {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 12px;
        margin: 2rem 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        background: var(--card);
      }

      th, td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
        border-right: 1px solid var(--border);
      }

      th { background: rgba(0,0,0,0.2); font-weight: bold; color: var(--accent); }

      .btn-next {
        display: block;
        width: fit-content;
        margin: 4rem auto 0;
        padding: 1rem 2.5rem;
        background: transparent;
        border: 2px dashed var(--accent);
        color: var(--accent);
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
      }

      .btn-next:hover {
        background: var(--accent);
        color: white;
        box-shadow: 0 0 25px rgba(37, 99, 235, 0.4);
      }

      code { background: rgba(128,128,128,0.1); padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      
      <div align="left">
        <a href="/assets/proyectos/182377_PR02_Parte I.pdf" download class="pdf-link">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1