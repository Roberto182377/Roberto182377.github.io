import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Contenido de los objetivos extraídos del MD
const objetivos = [
  "Configurar un entorno de virtualización aislado para realizar las pruebas de penetración de forma segura.",
  "Utilizar herramientas de escaneo de puertos y servicios para identificar posibles vectores de ataque.",
  "Enumerar los servicios y aplicaciones en ejecución para obtener información detallada sobre el sistema objetivo.",
  "Investigar las vulnerabilidades conocidas asociadas con los servicios y aplicaciones identificados.",
  "Evaluar el riesgo y la viabilidad de explotar cada vulnerabilidad.",
  "Seleccionar y adaptar los exploits adecuados para las vulnerabilidades encontradas.",
  "Escalar privilegios para obtener acceso administrativo.",
  "Registrar cada paso del proceso, incluyendo comandos utilizados, resultados obtenidos y capturas de pantalla.",
  "Explicar las técnicas y metodologías utilizadas en cada etapa del ataque.",
  "Grabar un video de la pantalla durante el proceso de ataque.",
  "Explicar cada paso del proceso en detalle, utilizando un lenguaje claro y conciso.",
  "Definir y explicar los términos técnicos utilizados durante el walkthrough."
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Walkthrough en acción - Seguridad Informática</title>
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        if (savedTheme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
    <style>
      :root { --bg: #ffffff; --text: #171717; --card: #f9f9f9; --accent: #2563eb; --dot: #80808030; --border: #e5e7eb; }
      .dark { --bg: #0a0a0a; --text: #ededed; --card: #151515; --accent: #60a5fa; --dot: #ffffff15; --border: #333333; }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', system-ui, sans-serif;
        background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px), radial-gradient(circle, var(--dot) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        margin: 0;
      }

      .container { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem; }
      
      /* Botón PDF */
      .pdf-container { margin-bottom: 3rem; text-align: left; }
      .pdf-link {
        color: var(--accent);
        text-decoration: none;
        border: 1px solid var(--accent);
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .pdf-link:hover { background: var(--accent); color: white; }

      /* Estructura de Secciones */
      section { margin-bottom: 4rem; }
      h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 2rem; line-height: 1.2; }
      h2 { font-size: 1.8rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.7rem; }
      h3 { font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1.5rem; color: var(--accent); }

      p { line-height: 1.7; margin-bottom: 1.2rem; opacity: 0.9; }
      ul { margin-bottom: 1.5rem; list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1rem; }
      li { line-height: 1.5; padding-left: 1.5rem; position: relative; font-size: 0.95rem; }
      li::before { content: "•"; position: absolute; left: 0; color: var(--accent); font-weight: bold; }

      /* Video Responsivo */
      .video-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 */
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--card);
        margin-top: 1.5rem;
      }
      .video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Botón Siguiente Página */
      .next-page-container {
        display: flex;
        justify-content: center;
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 1px dashed var(--border);
      }
      .btn-next {
        padding: 1rem 2.5rem;
        border: 2px dashed var(--accent);
        color: var(--accent);
        text-decoration: none;
        border-radius: 50px;
        font-weight: bold;
        transition: 0.3s;
      }
      .btn-next:hover {
        background: var(--accent);
        color: white;
        box-shadow: 0 0 20px rgba(37, 99, 235, 0.3);
      }

      @media (max-width: 768px) {
        ul { grid-template-columns: 1fr; }
        h1 { font-size: 2rem; }
      }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      
      <div class="pdf-container">
        <a href="/assets/proyectos/182377_Guía de Pentesting SnakeOil.pdf" download class="pdf-link">
          📄 Descargar Guía de Pentesting SnakeOil
        </a>
      </div>

      <h1>De la teoría a la práctica: walkthrough en acción</h1>

      <section>
        <h2>📌 Objetivos</h2>
        <p>
          Demostrar la capacidad de aplicar conocimientos teóricos de seguridad informática en un entorno práctico, mediante la realización de un walkthrough detallado y la explicación de las técnicas y metodologías utilizadas para vulnerar una máquina virtual.
        </p>
        <ul>
          {objetivos.map((objetivo) => (
            <li>{objetivo}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2>💾 Vídeo</h2>
        <h3>Prueba de Pentesting a SnakeOil</h3>
        <div class="video-wrapper">
          <iframe 
            src="https://www.youtube.com/embed/d1pYziBWWgQ" 
            title="YouTube video player" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
          </iframe>
        </div>
      </section>

      <div class="next-page-container">
        <a href="/proyectos/analisis-comparativo" class="btn-next">
          Ir al Análisis Comparativo →
        </a>
      </div>

    </main>
    <Footer />
  </body>
</html>