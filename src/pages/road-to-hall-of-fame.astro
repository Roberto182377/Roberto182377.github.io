---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { roadToHofFContent } from "../config/content.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{roadToHofFContent.meta.title}</title>
    <meta name="description" content={roadToHofFContent.meta.description} />
    
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme = savedTheme === "system" ? (prefersDark ? "dark" : "light") : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <style>
      /* 1. Variables Dinámicas */
      :root {
        --bg-main: #ffffff;
        --text-main: #171717;
        --dot-color: #80808030;
      }

      .dark {
        --bg-main: #0a0a0a;
        --text-main: #ededed;
        --dot-color: #ffffff20;
      }

      /* 2. Reset y Fondo Base */
      html, body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        overflow-x: hidden;
      }

      body {
        display: flex;
        flex-direction: column;
        background-color: var(--bg-main) !important; /* !important asegura que Tailwind no lo sobreescriba */
        color: var(--text-main);
        transition: background-color 0.3s ease;
        
        /* El patrón de puntos hexagonal */
        background-image: 
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px),
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        background-attachment: fixed;
      }

      main {
        flex: 1;
        width: 100%;
      }

      /* Estilo para los contenedores de los proyectos para que no sean transparentes */
      .project-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      
      .dark .project-card {
        background: #151515;
        border: 1px solid #33333380;
      }
    </style>
  </head>
  
  <body>
    <Navigation />
    
    <main class="flex-grow pt-24">
      <section class="max-w-4xl mx-auto px-6 mb-12">
        <h1 class="text-4xl font-bold text-neutral-900 dark:text-white mb-4">
          {roadToHofFContent.header.title}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400">
          {roadToHofFContent.header.description}
        </p>
      </section>

      <section class="max-w-4xl mx-auto px-6 pb-20">
        <div class="space-y-12">
          {
            roadToHofFContent.sections.map((section) => (
              <div>
                <h2 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-200 mb-6 border-b border-neutral-200 dark:border-neutral-800 pb-2">
                  {section.title}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {section.items.map((item) => (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group project-card p-4 rounded-xl transition-all duration-300 hover:scale-[1.02]"
                    >
                      <span class="flex items-center text-lg font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-500 transition-colors">
                        {item.title}
                        <svg
                          class="group-hover:translate-x-0 group-hover:translate-y-0 -rotate-45 translate-y-1 -translate-x-1 w-3 h-3 stroke-current ml-2 transition-all duration-200"
                          viewBox="0 0 13 15"
                        >
                          <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round">
                            <g transform="translate(0.666667, 2.333333)" stroke="currentColor" stroke-width="2.4">
                              <g>
                                <polyline class="transition-all duration-200 opacity-0 group-hover:opacity-100" points="5.33333333 0 10.8333333 5.5 5.33333333 11" />
                                <line class="transition-all duration-200 transform -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100" x1="10.8333333" y1="5.5" x2="0.833333333" y2="5.16666667" />
                              </g>
                            </g>
                          </g>
                        </svg>
                      </span>
                      <span class="text-base text-neutral-600 dark:text-neutral-400 block mt-1">
                        {item.description}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </main>
    
    <Footer />
  </body>
</html>