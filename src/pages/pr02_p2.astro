---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simulación de Phishing - Quiz Interactivo</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      :root {
        --bg: #0a0a0a;
        --text: #ededed;
        --card: #151515;
        --accent: #2563eb;
        --dot: #ffffff15;
        --border: #333333;
        --error: #ef4444;
        --success: #22c55e;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', system-ui, sans-serif;
        background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px), radial-gradient(circle, var(--dot) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        margin: 0;
      }

      .container { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem; }

      /* Registro Ampliado */
      .registration-card {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 3rem;
        border-radius: 16px;
        max-width: 850px; /* Incrementado para abarcar más pantalla */
        margin: 2rem auto;
        text-align: center;
      }

      .input-group { margin: 2rem 0; text-align: left; }
      input[type="text"] {
        width: 100%;
        padding: 1rem;
        background: #000;
        border: 1px solid var(--border);
        color: white;
        border-radius: 8px;
        font-size: 1.1rem;
      }

      .btn-primary {
        background: var(--accent);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        width: 100%;
        transition: 0.3s;
      }

      /* Quiz Styles */
      .quiz-container { display: none; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; }
      .scenario-img { width: 100%; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid var(--border); }
      
      /* Dashboard / Estadísticas */
      #dashboard { display: none; margin-top: 4rem; padding-top: 2rem; border-top: 1px dashed var(--border); }
      .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
      .stat-card { background: var(--card); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; }
      
      table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      th, td { padding: 1rem; text-align: left; border-bottom: 1px solid var(--border); }
      th { color: var(--accent); }
      .status-safe { color: var(--success); font-weight: bold; }
      .status-vulnerable { color: var(--error); font-weight: bold; }

      .hidden { display: none; }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      
      <div id="registration-section" class="registration-card">
        <h2 style="color: var(--accent); margin-bottom: 0.5rem;">Registro del Participante</h2>
        <p style="opacity: 0.7;">Identifícate para comenzar la simulación de ingeniería social.</p>
        <div class="input-group">
          <label style="display: block; margin-bottom: 0.5rem;">Ingresa tu Alias / Nombre:</label>
          <input type="text" id="user-alias" placeholder="Ej. Roberto" />
        </div>
        <div style="text-align: left; margin-bottom: 2rem; font-size: 0.9rem;">
          <input type="checkbox" id="consent"> 
          <label for="consent">Otorgo mi consentimiento informado para participar. No se capturan credenciales reales.</label>
        </div>
        <button id="start-btn" class="btn-primary">Comenzar Simulación</button>
      </div>

      <div id="quiz-section" class="quiz-container">
        <div id="question-header" style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
          <span id="progress-text">Escenario 1 de 10</span>
          <span id="timer-text" style="color: var(--accent);">Tiempo: 0s</span>
        </div>
        <div id="scenario-content">
          <h3 id="scenario-title">Cargando escenario...</h3>
           <p id="scenario-desc" style="opacity: 0.8; margin-bottom: 1.5rem;"></p>
           <img id="scenario-image" src="" class="scenario-img" alt="Phishing Evidence" />
           <div id="options-container" style="display: grid; gap: 1rem;"></div>
        </div>
      </div>

      <div id="dashboard">
        <h2 style="text-align: center; margin-bottom: 2rem;">🏆 Ranking de Resiliencia</h2>
        <div class="stat-card">
            <table id="ranking-table">
                <thead>
                    <tr>
                        <th>Rango</th>
                        <th>Participante</th>
                        <th>Puntaje</th>
                        <th>Eficiencia</th>
                        <th>Tiempo Prom.</th>
                    </tr>
                </thead>
                <tbody id="ranking-body">
                    </tbody>
            </table>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>📉 Escenarios más Fallados</h3>
                <canvas id="failedScenariosChart"></canvas>
            </div>
            <div class="stat-card">
                <h3>⏱️ Tiempo de Reacción (seg)</h3>
                <canvas id="reactionTimeChart"></canvas>
            </div>
        </div>
      </div>

    </main>
    <Footer />

    <script>
      // Configuración de Firebase (Datos de tu imagen)
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-app.js";
      import { getFirestore, collection, addDoc, getDocs, query, where, updateDoc, doc, orderBy, limit } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyAV4gRgxAYPggHmXwNAOr9f9iOUGTiRbU",
        authDomain: "phishing-quiz-31717.firebaseapp.com",
        databaseURL: "https://phishing-quiz-31717-default-rtdb.firebaseio.com",
        projectId: "phishing-quiz-31717",
        storageBucket: "phishing-quiz-31717.firebasestorage.app",
        messagingSenderId: "816745611137",
        appId: "1:816745611137:web:c87b3dc737cd544ca37280"
      };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);

      // --- Lógica del Quiz ---
      let currentStep = 0;
      let score = 0;
      let alias = "";
      let reactionTimes = [];
      let startTime;
      let interval;
      let failedScenarios = new Array(10).fill(0); // Para analítica local antes de subir

      // MOCK DE ESCENARIOS (Sustituye con tus 10 escenarios reales)
      const scenarios = [
        { title: "Sms de Rappi", desc: "¿El enlace 'rappi.app.link' es legítimo?", img: "/assets/images/posts/sms-rappi.png", correct: 0, options: ["Legítimo", "Phishing / Smishing"] },
        // ... agrega los otros 9 aquí
      ];

      const startBtn = document.getElementById('start-btn');
      const regSection = document.getElementById('registration-section');
      const quizSection = document.getElementById('quiz-section');
      const dashboard = document.getElementById('dashboard');

      startBtn.addEventListener('click', () => {
        alias = document.getElementById('user-alias').value.trim();
        const consent = document.getElementById('consent').checked;

        if(!alias || !consent) return alert("Por favor ingresa un nombre y acepta los términos.");

        regSection.style.display = 'none';
        quizSection.style.display = 'block';
        loadScenario();
      });

      function loadScenario() {
        if(currentStep >= scenarios.length) return finishQuiz();
        
        startTime = Date.now();
        const s = scenarios[currentStep];
        document.getElementById('progress-text').innerText = `Escenario ${currentStep + 1} de ${scenarios.length}`;
        document.getElementById('scenario-title').innerText = s.title;
        document.getElementById('scenario-desc').innerText = s.desc;
        document.getElementById('scenario-image').src = s.img;
        
        const container = document.getElementById('options-container');
        container.innerHTML = '';
        s.options.forEach((opt, i) => {
            const btn = document.createElement('button');
            btn.className = 'btn-primary';
            btn.style.background = '#222';
            btn.innerText = opt;
            btn.onclick = () => handleAnswer(i);
            container.appendChild(btn);
        });
      }

      function handleAnswer(index) {
        const endTime = Date.now();
        const timeTaken = (endTime - startTime) / 1000;
        reactionTimes.push(timeTaken);

        if(index === scenarios[currentStep].correct) {
            score += 10;
        } else {
            failedScenarios[currentStep] = 1;
        }

        currentStep++;
        loadScenario();
      }

      async function finishQuiz() {
        quizSection.innerHTML = `<h2 style="text-align:center">¡Quiz Terminado, ${alias}!</h2><p style="text-align:center">Tu puntuación: ${score}/100. Cargando estadísticas globales...</p>`;
        await saveResult();
        await renderDashboard();
        dashboard.style.display = 'block';
      }

      // --- Lógica de Firebase (ÚNICO USUARIO) ---
      async function saveResult() {
        const avgTime = (reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length).toFixed(1);
        const efficiency = score >= 70 ? "Seguro" : "Vulnerable";

        try {
            // BUSCAR SI EL USUARIO YA EXISTE
            const q = query(collection(db, "ranking"), where("alias", "==", alias));
            const querySnapshot = await getDocs(q);

            if (!querySnapshot.empty) {
                // Si existe, actualizamos el documento existente
                const userDoc = querySnapshot.docs[0];
                const existingData = userDoc.data();
                
                // Solo actualizamos si el nuevo score es mejor o para refrescar estadísticas
                await updateDoc(doc(db, "ranking", userDoc.id), {
                    puntaje: score, // Puedes poner una lógica de: Math.max(score, existingData.puntaje)
                    eficiencia: efficiency,
                    tiempoPromedio: `${avgTime}s`,
                    fallos: failedScenarios // Guardamos qué escenarios falló este usuario
                });
            } else {
                // Si no existe, creamos uno nuevo
                await addDoc(collection(db, "ranking"), {
                    alias: alias,
                    puntaje: score,
                    eficiencia: efficiency,
                    tiempoPromedio: `${avgTime}s`,
                    fallos: failedScenarios,
                    fecha: new Date()
                });
            }
        } catch (e) {
            console.error("Error al guardar:", e);
        }
      }

      async function renderDashboard() {
        const q = query(collection(db, "ranking"), orderBy("puntaje", "desc"), limit(10));
        const snap = await getDocs(q);
        const tbody = document.getElementById('ranking-body');
        tbody.innerHTML = '';

        let globalFailures = new Array(10).fill(0);
        let count = 1;

        snap.forEach(doc => {
            const d = doc.data();
            // Lógica para tabla
            tbody.innerHTML += `
                <tr>
                    <td>#${count++}</td>
                    <td>${d.alias}</td>
                    <td>${d.puntaje} / 100</td>
                    <td class="${d.eficiencia === 'Seguro' ? 'status-safe' : 'status-vulnerable'}">${d.eficiencia}</td>
                    <td>${d.tiempoPromedio}</td>
                </tr>
            `;

            // Acumular fallos para la gráfica global
            if(d.fallos) {
                d.fallos.forEach((f, i) => { if(f === 1) globalFailures[i]++; });
            }
        });

        initCharts(globalFailures);
      }

      function initCharts(failData) {
        // Gráfica de Barras (Escenarios fallados)
        new Chart(document.getElementById('failedScenariosChart'), {
            type: 'bar',
            data: {
                labels: ['E1', 'E2', 'E3', 'E4', 'E5', 'E6', 'E7', 'E8', 'E9', 'E10'],
                datasets: [{
                    label: 'Veces Fallado',
                    data: failData,
                    backgroundColor: '#ef4444'
                }]
            },
            options: { plugins: { legend: { display: false } } }
        });

        // Gráfica de Línea (Tiempos de reacción del usuario actual)
        new Chart(document.getElementById('reactionTimeChart'), {
            type: 'line',
            data: {
                labels: ['E1', 'E2', 'E3', 'E4', 'E5', 'E6', 'E7', 'E8', 'E9', 'E10'],
                datasets: [{
                    label: 'Segundos',
                    data: reactionTimes,
                    borderColor: '#2563eb',
                    tension: 0.4,
                    fill: true,
                    backgroundColor: 'rgba(37, 99, 235, 0.1)'
                }]
            }
        });
      }
    </script>
  </body>
</html>