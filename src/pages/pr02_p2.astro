---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SlyderNet - Phishing Quiz</title>
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAV4gRgxAYpgGmHmxwNAOr9f9iOUGtIrBU",
            authDomain: "phishing-quiz-31717.firebaseapp.com",
            databaseURL: "https://phishing-quiz-31717-default-rtdb.firebaseio.com",
            projectId: "phishing-quiz-31717",
            storageBucket: "phishing-quiz-31717.firebasestorage.app",
            messagingSenderId: "816745611137",
            appId: "1:816745611137:web:c87b3dc737cd544ca37280"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        window.db = db;
        window.setDoc = setDoc;
        window.doc = doc;
        window.getDoc = getDoc;
    </script>
    <style>
        :root { --bg: #0a0a0a; --text: #ededed; --accent: #60a5fa; --card: #151515; --border: #333; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; }
        .quiz-container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
        .scenario-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; }
        .email-view { background: #fff; color: #333; border-radius: 8px; padding: 1rem; margin: 1rem 0; font-family: Arial, sans-serif; }
        .email-header { border-bottom: 1px solid #ddd; padding-bottom: 0.5rem; margin-bottom: 1rem; }
        .btn-action { background: var(--accent); color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 8px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 1rem; }
        .fake-link { color: #1a73e8; text-decoration: underline; cursor: help; }
        .hidden { display: none; }
        .login-screen { text-align: center; padding: 4rem 2rem; }
        input { background: #222; border: 1px solid var(--border); color: white; padding: 0.8rem; border-radius: 8px; width: 100%; max-width: 300px; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <Navigation />
    <main class="quiz-container">
        <div id="setup-screen" class="login-screen">
            <h1>Bienvenido al Simulador</h1>
            <p>Ingresa tu nombre para comenzar. Si ya has participado, continuaremos con tu perfil único.</p>
            <input type="text" id="username" placeholder="Tu nombre o alias" />
            <button class="btn-action" onclick="startQuiz()">Comenzar Prueba</button>
        </div>

        <div id="quiz-screen" class="hidden">
            <div id="progress" style="margin-bottom: 1rem; opacity: 0.7;">Prueba 1 de 10</div>
            <div id="scenario-content"></div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 2rem;">
                <button onclick="handleAnswer(false)" style="background: #ef4444;" class="btn-action">Es Phishing</button>
                <button onclick="handleAnswer(true)" style="background: #10b981;" class="btn-action">Es Legítimo</button>
            </div>
        </div>
    </main>

    <script is:inline>
        let currentStep = 0;
        let score = 0;
        let userAlias = "";
        let results = [];
        let startTime;

        const scenarios = [
            {
                title: "Donación de Piano",
                sender: "Leonor Del Pilar Martinez Aguilar",
                content: `¡Saludos! Una de nuestras exalumnas, la Sra. Angela, se muda... desea donar el piano Steinway... Información de contacto: <span class="fake-link" title="esto-es-phishing/prueba-cuidado.com" onclick="alert('Link: angelaharris051@outIook.com')">angelaharris051@outIook.com</span>`,
                isLegit: false,
                vector: "Urgencia / Gancho emocional"
            },
            {
                title: "Alerta Banco BBVA",
                sender: "serviciosecure.datosverified@sevurelink.es",
                content: `<strong>Estimado Cliente</strong>, para BBVA es fundamental la transparencia... actualizando nuestra Proteccionde Datos Personales. <br><br> <button onclick="alert('Link: confirmar-movil-bbva.seguridad.com')" class="fake-link">Confirmar número de teléfono</button>`,
                isLegit: false,
                vector: "Suplantación de identidad (Spoofing)"
            },
            {
                title: "Coca-Cola: Responde y Gana",
                sender: "email_Gep2pQ76g78@opmajvpqjcg.georgs-faescht.com",
                content: `<div style="text-align:center; background:#000; color:white; padding:10px;">
                    <h2 style="color:red;">RESPONDE Y GANA</h2>
                    <p>Licuadora y exprimidora portátil GRATUITA</p>
                    <button onclick="alert('Link: coca-cola-premios.xyz/ganar')" style="background:red; color:white; border:none; padding:10px;">COMENZAR AHORA</button>
                </div>`,
                isLegit: false,
                vector: "Premio falso"
            },
            {
                title: "Tarea de CNO V - Canva",
                sender: "Miguel Angel Aguilar Carrizales",
                content: `hola te comparto el link para que agregues tu parte a la presentación de la tarea de CNO V, revisala lo más pronto posible o de lo contrario te sacaremos del equipo.<br><br>
                <span class="fake-link" onclick="alert('Link: canva.com.presentation-edit.ga/DAHDf3y87JU')">https://www.canva.com/design/DAHDf3y87JU/...</span>`,
                isLegit: false,
                vector: "Presión social / Académico"
            },
            {
                title: "Dropbox: Espacio Lleno",
                sender: "no-reply@dropboxmail.com",
                content: `Tu cuenta de Dropbox está llena y ya no sincroniza los archivos... <br><br> <span class="fake-link" onclick="alert('Link: dropbox.com/buy-space')">Actualizar tu cuenta de Dropbox</span>`,
                isLegit: true,
                vector: "Notificación de servicio real"
            },
            {
                title: "SMS: Código de Verificación",
                sender: "646-555-0110",
                content: `<div style="background:#e5e5ea; color:black; padding:10px; border-radius:15px; margin-bottom:5px;">¿Solicitaste restablecer la contraseña? Si es así, ignora el mensaje. De lo contrario, responde con CANCELAR y el código de verificación.</div>
                <div style="background:#e5e5ea; color:black; padding:10px; border-radius:15px; margin-left:20px;">Tu código de verificación de Google es 131025.</div>`,
                isLegit: false,
                vector: "Robo de 2FA vía SMS"
            },
            {
                title: "Instagram: Código de Inicio",
                sender: "Instagram (Verificado)",
                content: `<div style="background:#222; color:white; padding:10px; border-radius:10px;">
                    <strong>782 194</strong> es su código de inicio de sesión de Instagram. Debe mantenerse en privado.
                </div>`,
                isLegit: true,
                vector: "Seguridad de cuenta real"
            },
            {
                title: "Netflix: Suspensión de cuenta",
                sender: "info@netflix-billing.com",
                content: `Estimado usuario, tu membresía está en espera debido a un problema con el pago. <br><br> <span class="fake-link" onclick="alert('Link: netflix.com-update.net')">Actualizar pago</span>`,
                isLegit: false,
                vector: "Suscripción / Pago"
            },
            {
                title: "Microsoft Office 365",
                sender: "admin@m365-security.com",
                content: `Actividad de inicio de sesión inusual detectada en tu cuenta de Microsoft. <br><br> <span class="fake-link" onclick="alert('Link: account-live-com.security-check.ru')">Revisar actividad reciente</span>`,
                isLegit: false,
                vector: "Alerta de seguridad falsa"
            },
            {
                title: "Amazon: Confirmación de Pedido",
                sender: "confirmation@amazon.com.mx",
                content: `Gracias por tu compra. Tu pedido #701-44321 ha sido enviado. <br><br> <span class="fake-link" onclick="alert('Link: amazon.com.mx/orders')">Rastrear paquete</span>`,
                isLegit: true,
                vector: "E-commerce legítimo"
            }
        ];

        function startQuiz() {
            const input = document.getElementById('username').value.trim();
            if(!input) return alert("Por favor ingresa un nombre");
            userAlias = input;
            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            renderScenario();
        }

        function renderScenario() {
            startTime = Date.now();
            const s = scenarios[currentStep];
            document.getElementById('progress').innerText = `Prueba ${currentStep + 1} de 10`;
            document.getElementById('scenario-content').innerHTML = `
                <div class="scenario-card">
                    <div class="email-view">
                        <div class="email-header">
                            <strong>De:</strong> ${s.sender} <br>
                            <strong>Asunto:</strong> ${s.title}
                        </div>
                        <div>${s.content}</div>
                    </div>
                </div>
            `;
        }

        function handleAnswer(userSaysLegit) {
            const timeTaken = (Date.now() - startTime) / 1000;
            const correct = userSaysLegit === scenarios[currentStep].isLegit;
            
            if(correct) score += 10;
            
            results.push({
                vector: scenarios[currentStep].title,
                correct: correct,
                timeSeconds: timeTaken
            });

            currentStep++;
            if(currentStep < scenarios.length) {
                renderScenario();
            } else {
                finishQuiz();
            }
        }

        async function finishQuiz() {
            const userRef = window.doc(window.db, "ranking", userAlias.toLowerCase());
            
            const data = {
                alias: userAlias,
                totalScore: score,
                details: results,
                date: new Date().toISOString()
            };

            try {
                await window.setDoc(userRef, data, { merge: true });
                window.location.href = `/scoreboard?user=${encodeURIComponent(userAlias)}`;
            } catch (e) {
                console.error("Error al guardar:", e);
                alert("Error al conectar con la base de datos.");
            }
        }
    </script>
</body>
</html>