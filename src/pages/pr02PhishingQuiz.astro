---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phishing Quiz & Global Score</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        if (savedTheme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
    <style>
      :root { --bg: #ffffff; --text: #171717; --card: #f9f9f9; --accent: #3b82f6; --dot: #80808030; --border: #e5e7eb; --success: #16a34a; --danger: #dc2626; --chart-bg: #1e1e1e; }
      .dark { --bg: #0a0a0a; --text: #ededed; --card: #151515; --accent: #3b82f6; --dot: #ffffff15; --border: #333333; --success: #22c55e; --danger: #ef4444; --chart-bg: #151515; }

      body { background-color: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px), radial-gradient(circle, var(--dot) 1px, transparent 1px); background-size: 24px 41.57px; background-position: 0 0, 12px 20.78px; margin: 0; }
      .container { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem; }
      h1, h2, h3 { font-weight: 800; margin-bottom: 1.5rem; }
      h1 { font-size: 2.5rem; text-align: center; }
      h2 { font-size: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
      .hidden { display: none !important; }

      /* Botones y Formularios */
      input[type="text"] { width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); margin-bottom: 1rem; }
      .btn { padding: 0.8rem 1.5rem; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s; border: none; }
      .btn-primary { background: var(--accent); color: white; width: 100%; }
      .btn-primary:hover { opacity: 0.9; }
      .btn-phishing { background: var(--danger); color: white; width: 48%; }
      .btn-safe { background: var(--success); color: white; width: 48%; }

      /* Links Inspeccionables */
      .phish-link { color: var(--accent); text-decoration: underline; cursor: pointer; font-weight: bold; padding: 0.2rem 0.4rem; background: rgba(59, 130, 246, 0.1); border-radius: 4px; }
      .phish-link:hover { background: rgba(59, 130, 246, 0.2); }
      
      /* Estilo para imágenes dentro del contenido */
      .scenario-img { max-width: 100%; height: auto; border-radius: 8px; margin: 1rem 0; display: block; border: 1px solid var(--border); }
      .img-clickable { cursor: zoom-in; transition: transform 0.2s; }
      .img-clickable:hover { transform: scale(1.02); }

      /* UI Correo */
      .email-ui { background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 2rem; }
      .email-header { padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; }
      .avatar { width: 50px; height: 50px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; }
      .email-info p { margin: 0; line-height: 1.4; }
      .sender-name { font-weight: bold; font-size: 1.1rem; }
      .sender-email { font-size: 0.85rem; opacity: 0.7; }
      .email-subject { font-size: 1.3rem; font-weight: bold; padding: 1.5rem 1.5rem 0 1.5rem; }
      .email-body { padding: 1.5rem; font-size: 0.95rem; white-space: pre-wrap; line-height: 1.6; }

      /* UI SMS */
      .sms-ui { background: var(--bg); border: 1px solid var(--border); border-radius: 30px; overflow: hidden; margin: 0 auto 2rem auto; width: 100%; max-width: 400px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
      .sms-header { background: var(--card); padding: 1rem; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
      .sms-avatar { width: 60px; height: 60px; border-radius: 50%; background: #9ca3af; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: white; }
      .sms-sender { font-weight: bold; font-size: 1rem; }
      .sms-number { font-size: 0.8rem; opacity: 0.6; }
      .sms-body-container { padding: 1.5rem; background: var(--bg); display: flex; flex-direction: column; gap: 1rem; min-height: 200px; }
      .sms-bubble { background: #3b82f6; color: white; padding: 1rem; border-radius: 18px; border-bottom-left-radius: 4px; max-width: 85%; align-self: flex-start; font-size: 0.95rem; line-height: 1.4; white-space: pre-wrap; }
      .sms-bubble .phish-link { color: #bfdbfe; background: transparent; text-decoration: underline; padding: 0; }

      /* Dashboard UI */
      .actions { display: flex; justify-content: space-between; margin-top: 1rem; }
      .feedback-box { padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid var(--accent); background: var(--card); }
      .feedback-box ul { margin-top: 1rem; padding-left: 1.5rem; }
      
      .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }
      @media (max-width: 768px) { .dashboard-grid { grid-template-columns: 1fr; } }
      .dash-card { background: var(--chart-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
      .dash-card h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
      
      /* Tabla Ranking */
      .table-container { overflow-x: auto; background: var(--chart-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-top: 1.5rem; }
      table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
      th, td { padding: 1rem 0.5rem; border-bottom: 1px solid var(--border); }
      th { color: var(--accent); font-weight: bold; }
      .badge { padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.8rem; font-weight: bold; }
      .badge.seguro { background: rgba(34, 197, 94, 0.2); color: var(--success); }
      .badge.vulnerable { background: rgba(239, 68, 68, 0.2); color: var(--danger); }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      <h1>Simulación de Phishing</h1>

      <section id="intro-section">
        <h2>Phishing Quiz</h2>
        <div class="dash-card" style="max-width: 800px; margin: 0 auto; padding: 2.5rem; text-align: center;">
          <p style="margin-bottom: 2rem; opacity: 0.9; font-size: 1.1rem; line-height: 1.5;">
            Pon a prueba tus habilidades para detectar correos y mensajes fraudulentos. Analiza 10 escenarios que te pondran a prueba y descubre tu nivel de conocimiento frente a ataques de ingeniería social.
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">
            <div style="background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
              <span style="display: block; font-size: 1.5rem; margin-bottom: 0.5rem;">⏱️</span>
              <strong style="display: block; font-size: 0.9rem;">No te preocupes por hacer clic en los links (puedes hacerlo paracomprobar si es real o falso)</strong>
              <span style="font-size: 0.8rem; opacity: 0.7;">Tiempo estimado</span>
            </div>
            <div style="background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
              <span style="display: block; font-size: 1.5rem; margin-bottom: 0.5rem;">📊</span>
              <strong style="display: block; font-size: 0.9rem;">Compruba tu resultados y tiempo de reacción</strong>
              <span style="font-size: 0.8rem; opacity: 0.7;">Análisis de tu nivel de riesgo</span>
            </div>
            <div style="background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
              <span style="display: block; font-size: 1.5rem; margin-bottom: 0.5rem;">🛡️</span>
              <strong style="display: block; font-size: 0.9rem;">Entorno Seguro</strong>
              <span style="font-size: 0.8rem; opacity: 0.7;">Sin captura de datos reales</span>
            </div>
          </div>
          <div style="text-align: left; max-width: 500px; margin: 0 auto;">
            <label for="username">Ingresa tu Alias / Nombre:</label>
            <input type="text" id="username" placeholder="Ej. tester123" required />
            <label style="display: flex; gap: 0.5rem; align-items: start; font-size: 0.85rem; margin-bottom: 1.5rem;">
              <input type="checkbox" id="consent" required />
              <span>Otorgo mi consentimiento informado para participar. [cite: 58] No se capturan credenciales reales. [cite: 59]</span>
            </label>
            <button class="btn btn-primary" id="btn-start" style="font-size: 1.1rem; padding: 1rem;">Comenzar Simulación</button>
          </div>
        </div>
      </section>

      <section id="quiz-section" class="hidden">
        <h2>Escenario <span id="progress-text">1/10</span></h2>
        
        <div id="ui-email" class="email-ui hidden">
          <div class="email-header">
            <div class="avatar" id="avatar-letter">G</div>
            <div class="email-info">
              <p class="sender-name" id="ui-sender-name"></p>
              <p class="sender-email" id="ui-sender-email"></p>
              <p class="sender-email" style="font-size: 0.75rem;">Para: <span id="ui-recipient"></span></p>
            </div>
          </div>
          <div class="email-subject" id="ui-subject"></div>
          <div class="email-body" id="ui-body"></div>
        </div>

        <div id="ui-sms" class="sms-ui hidden">
          <div class="sms-header">
            <div class="sms-avatar">👤</div>
            <div class="sms-sender" id="sms-sender-name"></div>
            <div class="sms-number" id="sms-sender-number"></div>
          </div>
          <div class="sms-body-container">
            <div class="sms-bubble" id="sms-body"></div>
          </div>
        </div>

        <div id="action-buttons" class="actions">
          <button class="btn btn-phishing" id="btn-is-phishing">Es Phishing</button>
          <button class="btn btn-safe" id="btn-is-safe">Es Seguro</button>
        </div>

        <div id="feedback-container" class="feedback-box hidden">
          <h3 id="feedback-title"></h3>
          <p id="feedback-desc"></p>
          <ul id="feedback-points"></ul>
          <button class="btn btn-primary" id="btn-next" style="margin-top: 1rem;">Siguiente Escenario</button>
        </div>
      </section>

      <section id="dashboard-section" style="margin-top: 3rem;">
        <div id="individual-results" class="dash-card hidden" style="margin-bottom: 2rem; border-color: var(--accent);">
          <h2 style="border:none; margin:0; padding:0; text-align:center;">Tu Resultado: <span id="ind-score-value" style="color:var(--accent);"></span></h2>
          <p style="text-align:center; margin:0; opacity:0.8;">Tiempo promedio de análisis: <span id="ind-time-value"></span>s por escenario.</p>
          <div style="text-align: center; margin-top: 1.5rem;">
            <button class="btn btn-primary" id="btn-restart" style="max-width: 300px;">Volver al inicio</button>
          </div>
        </div>

        <h2>Ranking Global</h2>
        <div class="table-container">
          <table>
            <thead><tr><th>Rango</th><th>Participante</th><th>Puntaje</th><th>Eficiencia</th><th>Tiempo Prom.</th></tr></thead>
            <tbody id="ranking-body"><tr><td colspan="5" style="text-align:center;">Cargando datos en tiempo real... [cite: 68]</td></tr></tbody>
          </table>
        </div>

        <div class="dashboard-grid">
          <div class="dash-card">
            <h3>Escenarios más Fallados</h3>
            <p style="font-size:0.8rem; opacity:0.8; margin-bottom:1rem;">Identificación de los vectores con mayor tasa de éxito. [cite: 69]</p>
            <canvas id="failuresChart"></canvas>
          </div>
          <div class="dash-card">
            <h3>Tiempo de Reacción (seg)</h3>
            <p style="font-size:0.8rem; opacity:0.8; margin-bottom:1rem;">Análisis de duda: Escenarios que requirieron mayor tiempo. [cite: 70]</p>
            <canvas id="timeChart"></canvas>
          </div>
        </div>
      </section>

    </main>
    <Footer />

