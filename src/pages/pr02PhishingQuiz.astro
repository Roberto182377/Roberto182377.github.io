---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phishing Quiz & Global Score</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        if (savedTheme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
    <style>
      :root { --bg: #ffffff; --text: #171717; --card: #f9f9f9; --accent: #3b82f6;
      --dot: #80808030; --border: #e5e7eb; --success: #16a34a; --danger: #dc2626; --chart-bg: #1e1e1e; }
      .dark { --bg: #0a0a0a;
      --text: #ededed; --card: #151515; --accent: #3b82f6; --dot: #ffffff15; --border: #333333; --success: #22c55e; --danger: #ef4444; --chart-bg: #151515;
      }

      body { background-color: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif;
      background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px), radial-gradient(circle, var(--dot) 1px, transparent 1px); background-size: 24px 41.57px; background-position: 0 0, 12px 20.78px;
      margin: 0; }
      .container { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem;
      }
      h1, h2, h3 { font-weight: 800; margin-bottom: 1.5rem;
      }
      h1 { font-size: 2.5rem; text-align: center;
      }
      h2 { font-size: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;
      }
      .hidden { display: none !important;
      }

      /* Botones y Formularios */
      input[type="text"] { width: 100%;
      padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); margin-bottom: 1rem;
      }
      .btn { padding: 0.8rem 1.5rem; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s;
      border: none; }
      .btn-primary { background: var(--accent); color: white; width: 100%;
      }
      .btn-primary:hover { opacity: 0.9; }
      .btn-phishing { background: var(--danger);
      color: white; width: 48%; }
      .btn-safe { background: var(--success); color: white; width: 48%;
      }

      /* Links Inspeccionables */
      .phish-link { color: var(--accent);
      text-decoration: underline; cursor: pointer; font-weight: bold; padding: 0.2rem 0.4rem; background: rgba(59, 130, 246, 0.1); border-radius: 4px;
      }
      .phish-link:hover { background: rgba(59, 130, 246, 0.2);
      }

      /* UI Correo */
      .email-ui { background: var(--card);
      border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 2rem; }
      .email-header { padding: 1.5rem;
      border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; }
      .avatar { width: 50px;
      height: 50px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;
      }
      .email-info p { margin: 0; line-height: 1.4;
      }
      .sender-name { font-weight: bold; font-size: 1.1rem;
      }
      .sender-email { font-size: 0.85rem; opacity: 0.7;
      }
      .email-subject { font-size: 1.3rem; font-weight: bold; padding: 1.5rem 1.5rem 0 1.5rem;
      }
      .email-body { padding: 1.5rem; font-size: 0.95rem; white-space: pre-wrap; line-height: 1.6;
      }

      /* UI SMS */
      .sms-ui { background: var(--bg);
      border: 1px solid var(--border); border-radius: 30px; overflow: hidden; margin: 0 auto 2rem auto; width: 100%; max-width: 400px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
      .sms-header { background: var(--card); padding: 1rem;
      border-bottom: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
      }
      .sms-avatar { width: 60px; height: 60px; border-radius: 50%; background: #9ca3af; display: flex; align-items: center;
      justify-content: center; font-size: 2rem; color: white; }
      .sms-sender { font-weight: bold; font-size: 1rem;
      }
      .sms-number { font-size: 0.8rem; opacity: 0.6;
      }
      .sms-body-container { padding: 1.5rem; background: var(--bg); display: flex; flex-direction: column; gap: 1rem; min-height: 200px;
      }
      .sms-bubble { background: #3b82f6; color: white; padding: 1rem; border-radius: 18px; border-bottom-left-radius: 4px; max-width: 85%;
      align-self: flex-start; font-size: 0.95rem; line-height: 1.4; white-space: pre-wrap; }
      .sms-bubble .phish-link { color: #bfdbfe;
      background: transparent; text-decoration: underline; padding: 0; }

      /* Dashboard UI */
      .actions { display: flex;
      justify-content: space-between; margin-top: 1rem; }
      .feedback-box { padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;
      border-left: 4px solid var(--accent); background: var(--card); }
      .feedback-box ul { margin-top: 1rem; padding-left: 1.5rem;
      }
      
      .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr;
      gap: 1.5rem; margin-top: 1.5rem; }
      @media (max-width: 768px) { .dashboard-grid { grid-template-columns: 1fr;
      } }
      .dash-card { background: var(--chart-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;
      }
      .dash-card h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;
      border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1rem; }
      
      /* Tabla Ranking */
      .table-container { overflow-x: auto;
      background: var(--chart-bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-top: 1.5rem;
      }
      table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;
      }
      th, td { padding: 1rem 0.5rem; border-bottom: 1px solid var(--border);
      }
      th { color: var(--accent); font-weight: bold;
      }
      .badge { padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.8rem; font-weight: bold;
      }
      .badge.seguro { background: rgba(34, 197, 94, 0.2); color: var(--success);
      }
      .badge.vulnerable { background: rgba(239, 68, 68, 0.2); color: var(--danger);
      }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      <h1>Simulación de Phishing</h1>

      <section id="intro-section">
        <h2>Registro del Participante</h2>
        <div class="dash-card" style="max-width: 800px; margin: 0 auto; padding: 2.5rem; text-align: center;">
          <p style="margin-bottom: 2rem; opacity: 0.9; font-size: 1.1rem; line-height: 1.5;">
            Pon a prueba tus habilidades para detectar correos y mensajes fraudulentos. Analiza 10 escenarios realistas y descubre tu nivel de resiliencia frente a ataques de ingeniería social.
          </p>
          <div style="text-align: left; max-width: 500px; margin: 0 auto;">
            <label for="username">Ingresa tu Alias / Nombre:</label>
            <input type="text" id="username" placeholder="Ej. Roberto" required />
            <label style="display: flex; gap: 0.5rem; align-items: start; font-size: 0.85rem; margin-bottom: 1.5rem;">
              <input type="checkbox" id="consent" required />
              <span>Otorgo mi consentimiento informado para participar. No se capturan credenciales reales.</span>
            </label>
            <button class="btn btn-primary" id="btn-start" style="font-size: 1.1rem; padding: 1rem;">Comenzar Simulación</button>
          </div>
        </div>
      </section>

      <section id="quiz-section" class="hidden">
        <h2>Escenario <span id="progress-text">1/10</span></h2>
        
        <div id="ui-email" class="email-ui hidden">
          <div class="email-header">
            <div class="avatar" id="avatar-letter">G</div>
            <div class="email-info">
              <p class="sender-name" id="ui-sender-name"></p>
              <p class="sender-email" id="ui-sender-email"></p>
              <p class="sender-email" style="font-size: 0.75rem;">Para: <span id="ui-recipient"></span></p>
            </div>
          </div>
          <div class="email-subject" id="ui-subject"></div>
          <div class="email-body" id="ui-body"></div>
        </div>

        <div id="ui-sms" class="sms-ui hidden">
          <div class="sms-header">
            <div class="sms-avatar">👤</div>
            <div class="sms-sender" id="sms-sender-name"></div>
            <div class="sms-number" id="sms-sender-number"></div>
          </div>
          <div class="sms-body-container">
            <div class="sms-bubble" id="sms-body"></div>
          </div>
        </div>

        <div id="action-buttons" class="actions">
          <button class="btn btn-phishing" id="btn-is-phishing">Es Phishing</button>
          <button class="btn btn-safe" id="btn-is-safe">Es Seguro</button>
        </div>

        <div id="feedback-container" class="feedback-box hidden">
          <h3 id="feedback-title"></h3>
          <p id="feedback-desc"></p>
          <ul id="feedback-points"></ul>
          <button class="btn btn-primary" id="btn-next" style="margin-top: 1rem;">Siguiente Escenario</button>
        </div>
      </section>

      <section id="dashboard-section" style="margin-top: 3rem;">
        
        <div id="individual-results" class="dash-card hidden" style="margin-bottom: 2rem; border-color: var(--accent);">
          <h2 style="border:none; margin:0; padding:0; text-align:center;">Tu Resultado: <span id="ind-score-value" style="color:var(--accent);"></span></h2>
          <p style="text-align:center; margin:0; opacity:0.8;">Tiempo promedio de análisis: <span id="ind-time-value"></span>s por escenario.</p>
          <div style="text-align: center; margin-top: 1.5rem;">
            <button class="btn btn-primary" id="btn-restart" style="max-width: 300px;">Volver al inicio</button>
          </div>
        </div>

        <h2>🏆 Ranking de Resiliencia Global</h2>
        <div class="table-container">
          <table>
            <thead><tr><th>Rango</th><th>Participante</th><th>Puntaje</th><th>Eficiencia</th><th>Tiempo Prom.</th></tr></thead>
            <tbody id="ranking-body"><tr><td colspan="5" style="text-align:center;">Cargando datos en tiempo real...</td></tr></tbody>
          </table>
        </div>

        <div class="dashboard-grid">
          <div class="dash-card">
            <h3>📉 Escenarios más Fallados</h3>
            <p style="font-size:0.8rem; opacity:0.8; margin-bottom:1rem;">Identificación de los vectores con mayor tasa de éxito.</p>
            <canvas id="failuresChart"></canvas>
          </div>
          <div class="dash-card">
            <h3>⏱️ Tiempo de Reacción (seg)</h3>
            <p style="font-size:0.8rem; opacity:0.8; margin-bottom:1rem;">Análisis de duda: Escenarios que requirieron mayor tiempo.</p>
            <canvas id="timeChart"></canvas>
          </div>
        </div>
      </section>

    </main>
    <Footer />

    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
      import { getDatabase, ref, push, set, onValue, update, increment } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

      // 1. CONFIGURACIÓN DE FIREBASE
      const firebaseConfig = {
        apiKey: "AIzaSyAV4gRgxAYpgGmHmxwNAOr9f9iOUGtIrBU",
        authDomain: "phishing-quiz-31717.firebaseapp.com",
        databaseURL: "https://phishing-quiz-31717-default-rtdb.firebaseio.com",
        projectId: "phishing-quiz-31717",
        storageBucket: "phishing-quiz-31717.firebasestorage.app",
        messagingSenderId: "816745611137",
        appId: "1:816745611137:web:c87b3dc737cd544ca37280"
      };
      const app = initializeApp(firebaseConfig);
      const db = getDatabase(app);

      // Función Helper para los enlaces inspeccionables
      window.inspectLink = function(realUrl) { 
        alert("Has inspeccionado el enlace.\nURL Real de destino:\n\n" + realUrl);
        return false; 
      }

      // 2. BASE DE DATOS DE ESCENARIOS
      const allScenarios = [
        {
          id: 1, type: "email", senderName: "Equipo de Seguridad de Google", senderEmail: "no-reply@accounts.google.security-alerts.com",
          subject: "Alerta de seguridad crítica",
          body: "Hemos detectado un intento de inicio de sesión sospechoso en tu cuenta desde Moscú.\n\nPor favor asegura tu cuenta inmediatamente haciendo clic aquí:\n\n<a href='http://myaccount.google.security-alerts.com/verify\' style="color: blue; text-decoration: underline;" onclick='return inspectLink(\"http://myaccount.google.security-alerts.com/verify\")' class='phish-link' title='Inspeccionar Enlace'>Proteger mi cuenta</a>",
          isPhishing: true, feedback: ["Subdominio engañoso: 'google.security-alerts.com' no es Google.", "Urgencia: Intenta crear pánico.", "La URL de destino es HTTP, no HTTPS."]
        },
        {
          id: 2, type: "email", senderName: "Recursos Humanos", senderEmail: "hr@tuempresa.com",
          subject: "IMPORTANTE: Política de Vacaciones",
          body: "Hola a todos,\n\nHemos actualizado nuestra política de vacaciones. Por favor revisen la intranet corporativa o el documento adjunto.\n\nSaludos.",
          isPhishing: false, feedback: ["Remitente legítimo interno.", "Tono informativo, no exige acciones con urgencia ni pide contraseñas."]
        },
        {
          id: 3, type: "sms", senderName: "Rappi", senderEmail: "5544332211",
          subject: "",
          body: "Rappi: Tienes 150 de descuento en Las Alitas, Papa Johns y mas. <a href='#' onclick='return inspectLink(\"https://rappi.promo-app.link/descuento150\")' class='phish-link' title='Inspeccionar'>https://rappi.app.link/5X2a</a> Aplican T&C",
          isPhishing: true, feedback: ["Smishing (Phishing por SMS).", "El texto visible dice 'rappi.app.link', pero al inspeccionarlo te lleva a 'rappi.promo-app.link', un dominio falso.", "Busca aprovechar el deseo de una recompensa (descuento)."]
        },
        {
          id: 4, type: "email", senderName: "Carlos Director (CEO)", senderEmail: "carlos.director.exec@gmail.com",
          subject: "Urgente: Transferencia requerida",
          body: "¿Estás en la oficina?\n\nNecesito que proceses una transferencia internacional a un nuevo proveedor hoy mismo. Respóndeme para darte los datos. No me llames, estoy en reunión.",
          isPhishing: true, feedback: ["Fraude del CEO (BEC).", "Uso de correo personal (gmail) para temas financieros corporativos.", "Exige saltarse los procedimientos normales pidiendo que no se le contacte para verificar."]
        },
        {
          id: 5, type: "email", senderName: "Google Drive", senderEmail: "drive-shares-noreply@google.com",
          subject: "Proyecto_Final_V2.docx compartido",
          body: "María te ha invitado a colaborar en el siguiente documento:\n\n<a href='#' onclick='return inspectLink(\"https://docs.google.com/document/d/1A2B3C4D5E/edit\")' class='phish-link' title='Inspeccionar'>Abrir en Docs</a>",
          isPhishing: false, feedback: ["Dominio legítimo (@google.com).", "El enlace inspeccionado lleva a un recurso legítimo HTTPS de docs.google.com."]
        },
        {
          id: 6, type: "email", senderName: "Administrador de TI", senderEmail: "admin@it-soporte-interno.com",
          subject: "Actualización de seguridad",
          body: "Debe instalar el siguiente parche en su equipo antes de las 17:00 hrs para evitar la desconexión de la red.\n\n<a href='#' onclick='return inspectLink(\"http://it-soporte-interno.com/Parche_v2.exe\")' class='phish-link' title='Inspeccionar'>Descargar Parche.exe</a>",
          isPhishing: true, feedback: ["Amenaza implícita de desconexión.", "Descarga directa de un archivo ejecutable (.exe).", "Dominio externo genérico."]
        },
        {
          id: 7, type: "sms", senderName: "Banamex", senderEmail: "22626",
          subject: "",
          body: "Banamex Alerta: Cargo retenido por $1,500 en Amazon. Responde CANCELAR o ingresa para verificar: <a href='#' onclick='return inspectLink(\"http://alertas-banamex-seguridad.com/login\")' class='phish-link' title='Inspeccionar'>https://banco.banamex.com/alertas</a>",
          isPhishing: true, feedback: ["Falsa alerta de fraude bancario para generar pánico instantáneo.", "El link visible parece seguro, pero la redirección real es a una página HTTP falsa ('alertas-banamex-seguridad.com')."]
        },
        {
          id: 8, type: "email", senderName: "LinkedIn", senderEmail: "messages-noreply@linkedin.com",
          subject: "Nueva solicitud de conexión",
          body: "Hola,\n\nRoberto ha solicitado unirse a tu red profesional.\n\n<a href='#' onclick='return inspectLink(\"https://www.linkedin.com/in/roberto182377\")' class='phish-link' title='Inspeccionar'>Ver perfil</a>",
          isPhishing: false, feedback: ["Comportamiento esperado y dominio correcto.", "El enlace dirige de forma segura al perfil real dentro de LinkedIn."]
        },
        {
          id: 9, type: "sms", senderName: "FedEx Info", senderEmail: "80090012",
          subject: "",
          body: "FedEx: Su paquete esta retenido en aduana por falta de pago. Pague cuota de $2.99 USD para liberar entrega en: <a href='#' onclick='return inspectLink(\"http://rastreo.fedex-delivery-updates.com/pay\")' class='phish-link' title='Inspeccionar'>fedex.com/tracking</a>",
          isPhishing: true, feedback: ["Suplantación de marca de paquetería (muy común en SMS).", "Solicita un pago no esperado mediante un enlace fraudulento.", "La URL de destino no es oficial."]
        },
        {
          id: 10, type: "email", senderName: "Microsoft 365", senderEmail: "no-reply@microsoft.com",
          subject: "Contraseña expira en 24h",
          body: "Tu contraseña corporativa expirará. Mantén tu contraseña actual haciendo clic en el siguiente enlace y confirmando tus datos:\n\n<a href='#' onclick='return inspectLink(\"https://portal.office365-login-secure.com/auth\")' class='phish-link' title='Inspeccionar'>Mantener contraseña</a>",
          isPhishing: true, feedback: ["Ofrece 'mantener' la contraseña actual confirmando datos, lo cual es ilógico en políticas de seguridad reales.", "Dominio falso ('office365-login-secure.com')."]
        }
      ];

      // 3. ESTADO DE LA APP
      let currentUser = "", userEmail = "";
      let currentScenarios = [], currentIndex = 0;
      let score = 0, timeData = [], questionStartTime = 0;
      let scenarioTimes = [], failedScenariosLocal = [];

      let chartFallos = null, chartTiempos = null;

      function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
      }

      // 4. LÓGICA DE INTERFAZ Y QUIZ
      document.getElementById("btn-start").addEventListener("click", () => {
        const nameInput = document.getElementById("username").value.trim();
        const consent = document.getElementById("consent").checked;
        if (!nameInput || !consent) return alert("Ingresa tu nombre y acepta el consentimiento.");

        currentUser = nameInput;
        userEmail = `${currentUser.toLowerCase().replace(/\s/g, '')}@gmail.com`;
        
        // Reiniciar variables en caso de jugar de nuevo
        currentIndex = 0;
        score = 0;
        timeData = [];
        scenarioTimes = [];
        failedScenariosLocal = [];
        
        // Ocultar Intro y Dashboard global, mostrar Quiz
        document.getElementById("intro-section").classList.add("hidden");
        document.getElementById("dashboard-section").classList.add("hidden");
        document.getElementById("quiz-section").classList.remove("hidden");
        
        currentScenarios = shuffleArray([...allScenarios]);
        loadQuestion();
      });

      // Botón para reiniciar/volver a jugar
      document.getElementById("btn-restart").addEventListener("click", () => {
        document.getElementById("individual-results").classList.add("hidden");
        document.getElementById("intro-section").classList.remove("hidden");
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      function loadQuestion() {
        if (currentIndex >= currentScenarios.length) return finishQuiz();

        const scenario = currentScenarios[currentIndex];
        document.getElementById("progress-text").innerText = `${currentIndex + 1}/${currentScenarios.length}`;
        
        // Alternar UI Email vs SMS
        if (scenario.type === "email") {
          document.getElementById("ui-email").classList.remove("hidden");
          document.getElementById("ui-sms").classList.add("hidden");
          document.getElementById("avatar-letter").innerText = scenario.senderName.charAt(0).toUpperCase();
          document.getElementById("ui-sender-name").innerText = scenario.senderName;
          document.getElementById("ui-sender-email").innerText = `<${scenario.senderEmail}>`;
          document.getElementById("ui-recipient").innerText = userEmail;
          document.getElementById("ui-subject").innerText = scenario.subject;
          document.getElementById("ui-body").innerHTML = scenario.body.replace(/\n/g, "<br>");
        } else {
          document.getElementById("ui-email").classList.add("hidden");
          document.getElementById("ui-sms").classList.remove("hidden");
          document.getElementById("sms-sender-name").innerText = scenario.senderName;
          document.getElementById("sms-sender-number").innerText = scenario.senderEmail;
          document.getElementById("sms-body").innerHTML = scenario.body;
        }

        document.getElementById("feedback-container").classList.add("hidden");
        document.getElementById("action-buttons").classList.remove("hidden");
        questionStartTime = Date.now();
      }

      function handleAnswer(userSaidPhishing) {
        const timeTaken = (Date.now() - questionStartTime) / 1000;
        const scenario = currentScenarios[currentIndex];
        
        timeData.push(timeTaken);
        scenarioTimes.push({ id: scenario.id, time: timeTaken });

        const isCorrect = userSaidPhishing === scenario.isPhishing;
        if (isCorrect) score++;
        else failedScenariosLocal.push(scenario.id);

        // Feedback
        document.getElementById("action-buttons").classList.add("hidden");
        const fbContainer = document.getElementById("feedback-container");
        fbContainer.classList.remove("hidden");
        const title = document.getElementById("feedback-title");
        title.innerText = isCorrect ? "¡Correcto!" : "Incorrecto.";
        title.style.color = isCorrect ? "var(--success)" : "var(--danger)";
        document.getElementById("feedback-desc").innerText = scenario.isPhishing ? "Era un ataque de Phishing:" : "Era Legítimo y seguro:";
        
        const ul = document.getElementById("feedback-points");
        ul.innerHTML = "";
        scenario.feedback.forEach(point => {
          const li = document.createElement("li"); li.innerText = point; ul.appendChild(li);
        });
      }

      document.getElementById("btn-is-phishing").addEventListener("click", () => handleAnswer(true));
      document.getElementById("btn-is-safe").addEventListener("click", () => handleAnswer(false));
      document.getElementById("btn-next").addEventListener("click", () => { currentIndex++; loadQuestion(); });

      // 5. ENVÍO DE DATOS A FIREBASE (Con lógica de deduplicación)
      function finishQuiz() {
        document.getElementById("quiz-section").classList.add("hidden");
        // Mostrar nuevamente el Dashboard y los resultados individuales
        document.getElementById("dashboard-section").classList.remove("hidden");
        document.getElementById("individual-results").classList.remove("hidden");
        
        const finalScore100 = (score / 10) * 100;
        const avgTime = timeData.reduce((a, b) => a + b, 0) / timeData.length;
        document.getElementById("ind-score-value").innerText = `${finalScore100} / 100`;
        document.getElementById("ind-time-value").innerText = avgTime.toFixed(1);

        // Subir a Firebase - Generamos un ID único y constante basado en el nombre del usuario
        // Ej: "Admin User" se vuelve "adminuser". Así, si juega de nuevo, sobrescribe sus datos.
        const userKey = currentUser.toLowerCase().trim().replace(/[^a-z0-9]/g, '');
        // Fallback por si acaso el nombre resulta vacío tras la limpieza
        const safeKey = userKey || push(ref(db, 'users')).key;

        const updates = {};
        updates[`users/${safeKey}`] = {
          name: currentUser, 
          score: finalScore100, 
          time: Number(avgTime.toFixed(1)), 
          timestamp: Date.now()
        };
        
        failedScenariosLocal.forEach(id => { updates[`stats/failures/E${id}`] = increment(1); });
        scenarioTimes.forEach(st => {
          updates[`stats/times/E${st.id}/totalTime`] = increment(st.time);
          updates[`stats/times/E${st.id}/count`] = increment(1);
        });
        update(ref(db), updates);
      }

      // 6. ACTUALIZACIÓN DEL DASHBOARD EN TIEMPO REAL
      onValue(ref(db, '/'), (snapshot) => {
        const data = snapshot.val();
        if (!data) return;

        // Tabla de Ranking
        if (data.users) {
          const usersArr = Object.values(data.users).sort((a, b) => {
            if (b.score !== a.score) return b.score - a.score;
            return a.time - b.time;
          });
          
          const tbody = document.getElementById("ranking-body");
          tbody.innerHTML = "";
          usersArr.forEach((u, index) => {
            const tr = document.createElement("tr");
            const efficiency = u.score >= 80 ? '<span class="badge seguro">Seguro</span>' : '<span class="badge vulnerable">Vulnerable</span>';
            tr.innerHTML = `<td>#${index + 1}</td><td>${u.name}</td><td>${u.score} / 100</td><td>${efficiency}</td><td>${u.time}s</td>`;
            tbody.appendChild(tr);
          });
        }

        // Preparar etiquetas E1 a E10
        const labels = Array.from({length: 10}, (_, i) => `E${i+1}`);
        // Gráfica de Fallos
        const failuresData = labels.map(label => (data.stats && data.stats.failures && data.stats.failures[label]) || 0);
        if(chartFallos) chartFallos.destroy();
        chartFallos = new Chart(document.getElementById('failuresChart'), {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{ label: 'Veces Fallado', data: failuresData, backgroundColor: '#ef4444' }]
          },
          options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1, color: '#888' } }, x: { ticks: { color: '#888' } } } }
        });
        // Gráfica de Tiempos
        const timesData = labels.map(label => {
          if(data.stats && data.stats.times && data.stats.times[label]) {
            const node = data.stats.times[label];
            return (node.totalTime / node.count).toFixed(1);
          }
          return 0;
        });
        if(chartTiempos) chartTiempos.destroy();
        chartTiempos = new Chart(document.getElementById('timeChart'), {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{ label: 'Tiempo Promedio (s)', data: timesData, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.2)', fill: true, tension: 0.4 }]
          },
          options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { color: '#888' } }, x: { ticks: { color: '#888' } } } }
        });
      });
    </script>
  </body>
</html>