---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SlyderNet - Ranking Global</title>
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, getDocs, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAV4gRgxAYpgGmHmxwNAOr9f9iOUGtIrBU",
            authDomain: "phishing-quiz-31717.firebaseapp.com",
            databaseURL: "https://phishing-quiz-31717-default-rtdb.firebaseio.com",
            projectId: "phishing-quiz-31717",
            storageBucket: "phishing-quiz-31717.firebasestorage.app",
            messagingSenderId: "816745611137",
            appId: "1:816745611137:web:c87b3dc737cd544ca37280"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        window.db = db;
        window.collection = collection;
        window.getDocs = getDocs;
    </script>
    <style>
        :root { --bg: #0a0a0a; --text: #ededed; --accent: #60a5fa; --card: #151515; --border: #333; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; }
        .container { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem; }
        .card { background: var(--card); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid var(--border); }
        th { color: var(--accent); }
        .hidden { display: none; }
        .badge { padding: 0.3rem 0.6rem; border-radius: 5px; font-size: 0.8rem; }
        .badge-safe { background: #10b98120; color: #10b981; }
        .badge-risk { background: #ef444420; color: #ef4444; }
    </style>
</head>
<body>
    <Navigation />
    <main class="container">
        
        <div class="card">
            <h3>🔍 Buscar Participante</h3>
            <div style="display: flex; gap: 10px;">
                <input type="text" id="searchInput" placeholder="Nombre exacto..." style="flex:1; background:#222; border:1px solid #333; color:white; padding:10px; border-radius:8px;" />
                <button onclick="searchUser()" style="background:var(--accent); border:none; color:white; padding:10px 20px; border-radius:8px; cursor:pointer;">Ver Análisis</button>
            </div>
        </div>

        <div id="personal-section" class="card hidden" style="border-left: 5px solid var(--accent);">
            <h2 id="user-welcome">Análisis Individual</h2>
            <div id="user-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                <div>
                    <span style="opacity:0.7">Puntaje Obtenido</span>
                    <div id="u-score" style="font-size: 2rem; font-weight: bold;">0 / 100</div>
                </div>
                <div>
                    <span style="opacity:0.7">Escenario más lento</span>
                    <div id="u-slowest" style="font-weight: bold; color: #facc15;">-</div>
                </div>
            </div>
            <p id="u-feedback" style="margin-top: 1.5rem; line-height: 1.6;"></p>
        </div>

        <div class="card">
            <h2>🏆 Ranking Global (Firestore)</h2>
            <table>
                <thead>
                    <tr>
                        <th>Rango</th>
                        <th>Nombre</th>
                        <th>Score</th>
                        <th>Estado</th>
                        <th>Última Prueba</th>
                    </tr>
                </thead>
                <tbody id="ranking-body">
                    <tr><td colspan="5">Cargando datos desde Firebase...</td></tr>
                </tbody>
            </table>
        </div>
    </main>

    <script is:inline>
        async function loadData() {
            const urlParams = new URLSearchParams(window.location.search);
            const userFilter = urlParams.get('user');

            try {
                const querySnapshot = await window.getDocs(window.collection(window.db, "ranking"));
                const allUsers = [];
                querySnapshot.forEach((doc) => allUsers.push(doc.data()));

                // Ordenar por score descendente
                allUsers.sort((a, b) => b.totalScore - a.totalScore);

                renderTable(allUsers);

                if (userFilter) {
                    const userData = allUsers.find(u => u.alias.toLowerCase() === userFilter.toLowerCase());
                    if (userData) showPersonalAnalysis(userData);
                }
            } catch (e) {
                console.error(e);
            }
        }

        function renderTable(data) {
            const tbody = document.getElementById('ranking-body');
            tbody.innerHTML = data.map((u, i) => `
                <tr>
                    <td>#${i + 1}</td>
                    <td><strong>${u.alias}</strong></td>
                    <td>${u.totalScore} / 100</td>
                    <td>
                        <span class="badge ${u.totalScore >= 70 ? 'badge-safe' : 'badge-risk'}">
                            ${u.totalScore >= 70 ? 'Seguro' : 'Vulnerable'}
                        </span>
                    </td>
                    <td style="font-size: 0.8rem; opacity: 0.6;">${new Date(u.date).toLocaleDateString()}</td>
                </tr>
            `).join('');
        }

        function showPersonalAnalysis(u) {
            document.getElementById('personal-section').classList.remove('hidden');
            document.getElementById('user-welcome').innerText = `Análisis de: ${u.alias}`;
            document.getElementById('u-score').innerText = `${u.totalScore} / 100`;

            // Encontrar el escenario más lento (Punto 3 de rúbrica)
            const slowest = [...u.details].sort((a, b) => b.timeSeconds - a.timeSeconds)[0];
            document.getElementById('u-slowest').innerText = `${slowest.vector} (${slowest.timeSeconds.toFixed(1)}s)`;

            const hits = u.details.filter(d => d.correct).length;
            document.getElementById('u-feedback').innerHTML = `
                Has superado <strong>${hits} de 10</strong> trampas de seguridad. 
                Tu tiempo de respuesta en el escenario de <em>${slowest.vector}</em> indica que es el tipo de ataque que más te genera duda. 
                ${u.totalScore < 70 ? '⚠️ Se recomienda revisar las señales de phishing en correos corporativos.' : '✅ Posees una buena cultura de prevención.'}
            `;
        }

        window.searchUser = () => {
            const val = document.getElementById('searchInput').value.trim();
            if(val) window.location.href = `?user=${encodeURIComponent(val)}`;
        };

        loadData();
    </script>
</body>
</html>