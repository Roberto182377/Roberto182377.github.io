---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const certificaciones = [
  {
    id: "cert-1",
    titulo: "Introducción a la Ciberseguridad",
    resena: "El certificado de "Introducción a la Ciberseguridad" ofrece una exploración exhaustiva y bien estructurada de los fundamentos defensivos y ofensivos en el entorno digital. A lo largo de sus módulos, el contenido abarca desde la protección de la privacidad de los datos, hasta el análisis de vulnerabilidades de red y las tácticas empleadas por los atacantes en la actualidad. Lo más destacable de este curso es su capacidad para desglosar la anatomía de los ciberataques, examinando métodos de infiltración específicos, como las diversas variantes de malware y las estrategias de ingeniería social. Asentar esta base teórica resulta indispensable para la aplicación técnica; por ejemplo, la comprensión de estos vectores de ataque facilita enormemente el diseño de proyectos orientados a la concientización, como la programación de simuladores de phishing educativos, o la resolución práctica de máquinas vulnerables en entornos controlados. Los cuestionarios y el análisis de casos refuerzan la capacidad de detectar y clasificar estas amenazas. Adicionalmente, el módulo enfocado en la defensa corporativa ofrece una perspectiva valiosa sobre la implementación de tecnologías, el control de acceso y las políticas de mitigación. Este apartado establece un marco de referencia excelente que resulta de gran utilidad al momento de llevar a cabo evaluaciones de seguridad de la información para departamentos específicos o al estructurar documentación y auditorías basadas en normativas internacionales. En resumen, es una certificación que proporciona un contexto sólido sobre el panorama de amenazas, preparando el terreno para especializaciones más avanzadas en el análisis de seguridad.",
    pdfUrl: "/assets/certificaciones/182377_introduccion a la ciberseguridad.pdf",
    badgeUrl: "/assets/images/about/badgeC1.png",
    iconUrl: "/assets/images/about/C1_.png",
  },
  {
    id: "cert-2",
    titulo: "Conceptos básicos de redes",
    resena: "no",
    pdfUrl: "/assets/certificaciones/182377_conceptos basicos de redes.pdf",
    badgeUrl: "/assets/images/about/badgeC2.png",
    iconUrl: "/assets/images/about/C2_.png",
  },
  {
    id: "cert-3",
    titulo: "Dispositivos de red y Configuración inicial",
    resena: " real.",
    pdfUrl: "/assets/certificaciones/182377_dispositivos de red y conf ini.pdf",
    badgeUrl: "/assets/images/about/badgeC3.png",
    iconUrl: "/assets/images/about/C3_.png",
  },
  {
    id: "cert-4",
    titulo: "Seguridad en Terminales",
    resena: "e interceptación o exfiltración de datos.",
    pdfUrl: "/assets/certificaciones/182377_seguridad de terminales.pdf",
    badgeUrl: "/assets/images/about/badgeC4.png",
    iconUrl: "/assets/images/about/C4_.png",
  },
  {
    id: "cert-5",
    titulo: "Administración de amenazas cibernéticas",
    resena: "ontrolados.",
    pdfUrl: "/assets/certificaciones/182377_administrador de amenazas.pdf",
    badgeUrl: "/assets/images/about/badgeC5.png",
    iconUrl: "/assets/images/about/C5_.png",
  },
  {
    id: "cert-6",
    titulo: "Carrera Profesional de Analista Jr en Ciberseguridad",
    resena: "deos.",
    pdfUrl: "/assets/certificaciones/182377_analista jr.pdf",
    badgeUrl: "/assets/images/about/badgeC6.png",
    iconUrl: "/assets/images/about/C6_.png",
  },
  {
    id: "cert-7",
    titulo: "Hacking Ético",
    resena: "io.",
    pdfUrl: "/assets/certificaciones/182377_hacking Etico.pdf",
    badgeUrl: "/assets/images/about/badgeC7.png",
    iconUrl: "/assets/images/about/C7.png",
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Certificaciones | Portafolio</title>
    <style>
      /* Variables Base - Ahora por defecto es Modo Oscuro */
      :root {
        --bg-main: #0a0a0a;
        --bg-card: #141414;
        --bg-hover: #1e1e1e;
        --text-title: #ededed;
        --text-body: #d1d1d1;
        --text-muted: #888888;
        --border-ui: rgba(255, 255, 255, 0.08);
        --accent-color: #2563eb;
        --dot-color: rgba(255, 255, 255, 0.15);
      }

      /* Cambia a Modo Claro si el portafolio activa una clase o atributo "light" */
      :global(html.light), :global(html[data-theme="light"]), :global(body.light) {
        --bg-main: #ffffff;
        --bg-card: #f8f9fa;
        --bg-hover: #f1f3f5;
        --text-title: #111111;
        --text-body: #333333;
        --text-muted: #6c757d;
        --border-ui: #e9ecef;
        --dot-color: rgba(0, 0, 0, 0.08);
      }

      body {
        margin: 0;
        background-color: var(--bg-main);
        color: var(--text-body);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-image: 
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px),
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        background-attachment: fixed;
        transition: background-color 0.4s ease, color 0.4s ease;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 5rem 1.5rem;
      }

      header { margin-bottom: 3.5rem; }
      
      h1 { 
        font-size: 2.6rem; 
        font-weight: 800; 
        letter-spacing: -0.03em; 
        color: var(--text-title);
        margin: 0; 
      }

      .cert-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 2.5rem;
        align-items: start;
      }

      /* PANEL IZQUIERDO */
      .cert-sidebar {
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 12px;
        overflow: hidden; 
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }

      .cert-btn {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--border-ui);
        color: var(--text-body);
        padding: 1.1rem 1.4rem;
        text-align: left;
        font-weight: 600; 
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); /* Transición más fluida */
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.8rem; /* Espaciado entre el logo y el texto */
      }

      /* NUEVA CLASE: Controla las dimensiones del logo en la lista */
      .cert-btn-icon {
        width: 24px;         /* Tamaño compacto ideal para la lista */
        height: 24px;
        object-fit: contain; /* Evita que el PNG se deforme */
        flex-shrink: 0;      /* Evita que el logo se aplaste si el texto es largo */
        transition: transform 0.2s ease;
      }

      /* Opcional: Un pequeño efecto de escala en el logo al pasar el cursor */
      .cert-btn:hover .cert-btn-icon {
        transform: scale(1.1);
      }

      .cert-btn:last-child {
        border-bottom: none;
      }

      .cert-btn:hover {
        background-color: var(--bg-hover);
        color: var(--text-title);
        padding-left: 1.8rem; /* Desplazamiento más notorio al hover */
      }

      .cert-btn.active {
        background-color: var(--bg-hover);
        color: var(--accent-color);
        padding-left: 1.8rem;
      }

      /* Indicador dinámico que "crece" */
      .cert-btn::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 0%; /* Inicia invisible */
        background-color: var(--accent-color);
        transition: height 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); /* Efecto rebote suave */
        border-radius: 0 4px 4px 0;
      }

      .cert-btn.active::before {
        height: 100%; /* Crece a tamaño completo al estar activo */
      }

      /* PANEL DERECHO */
      .cert-viewer {
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 14px;
        padding: 2.5rem;
        min-height: 380px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      .cert-content {
        display: none;
      }

      .cert-content.active {
        display: block;
      }

      /* =========================================
         ANIMACIONES EN CASCADA (STAGGERED)
         ========================================= */
      
      /* 1. La insignia salta (Pop In) */
      .cert-content.active .cert-badge-img {
        animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        opacity: 0;
      }

      /* 2. El título entra desde la izquierda */
      .cert-content.active h2 {
        animation: slideInLeft 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
        opacity: 0;
      }

      /* 3. El botón PDF entra desde la derecha */
      .cert-content.active .btn-pdf {
        animation: slideInRight 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
        opacity: 0;
      }

      /* 4. La reseña sube suavemente al final */
      .cert-content.active .resena-box {
        animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
        opacity: 0;
      }

      /* Keyframes para las físicas */
      @keyframes popIn {
        0% { opacity: 0; transform: scale(0.5) translateY(10px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
      }

      @keyframes slideInLeft {
        0% { opacity: 0; transform: translateX(-20px); }
        100% { opacity: 1; transform: translateX(0); }
      }

      @keyframes slideInRight {
        0% { opacity: 0; transform: translateX(20px); }
        100% { opacity: 1; transform: translateX(0); }
      }

      @keyframes slideUpFade {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }

      /* Elementos internos del visualizador */
      .viewer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-ui);
        padding-bottom: 1.5rem;
        margin-bottom: 1.8rem;
        gap: 1.5rem;
      }

      .title-integration {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        flex: 1;
      }

      .cert-badge-img {
        width: 120px;
        height: 120px;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.08));
      }

      .viewer-header h2 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-title);
        line-height: 1.3;
      }

      .btn-pdf {
        background: #950000;
        color: #ffffff;
        text-decoration: none;
        padding: 0.6rem 1.1rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
        flex-shrink: 0;
      }

      .btn-pdf:hover {
        background: #b91c1c;
        transform: translateY(-3px) scale(1.02); /* Se eleva y crece un poco */
        box-shadow: 0 6px 12px rgba(220, 38, 38, 0.2);
      }
      
      .btn-pdf:active {
        transform: translateY(0) scale(0.98); /* Sensación de ser presionado */
      }

      .resena-box {
        line-height: 1.7;
        color: var(--text-body);
        font-size: 1.05rem;
      }

      .resena-box p {
        margin: 0;
      }

      @media (max-width: 850px) {
        .cert-layout { 
          grid-template-columns: 1fr; 
          gap: 1.5rem;
        }
        .viewer-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        .btn-pdf {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <Navigation />
    
    <main class="container">
      <header>
        <h1>Certificaciones</h1>
        <h4>Apartado con la evidencia de los multiples certificados realizados durante el curso de seguridad informática</h4>
      </header>

      <div class="cert-layout">
        <aside class="cert-sidebar">
          {certificaciones.map((cert, index) => (
            <button 
              class={`cert-btn ${index === 0 ? 'active' : ''}`} 
              data-target={cert.id}
            >
              <img src={cert.iconUrl} alt="" class="cert-btn-icon" loading="lazy" />
              <span>{cert.titulo}</span>
            </button>
          ))}
        </aside>

        <section class="cert-viewer">
          {certificaciones.map((cert, index) => (
            <div id={cert.id} class={`cert-content ${index === 0 ? 'active' : ''}`}>
              <div class="viewer-header">
                <div class="title-integration">
                  <img src={cert.badgeUrl} alt={`Insignia de ${cert.titulo}`} class="cert-badge-img" loading="lazy" />
                  <h2>{cert.titulo}</h2>
                </div>
                <a href={cert.pdfUrl} download class="btn-pdf">
                  📄 Descargar PDF
                </a>
              </div>
              
              <div class="resena-box">
                <p>{cert.resena}</p>
              </div>
            </div>
          ))}
        </section>
      </div>
    </main>

    <Footer />

    <script is:inline>
      const buttons = document.querySelectorAll('.cert-btn');
      const contents = document.querySelectorAll('.cert-content');

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          if (button.classList.contains('active')) return;

          buttons.forEach(btn => btn.classList.remove('active'));
          contents.forEach(content => content.classList.remove('active'));

          button.classList.add('active');

          const targetId = button.getAttribute('data-target');
          const targetContent = document.getElementById(targetId);
          
          if (targetContent) {
            // Este void fuerza al navegador a recalcular el DOM, 
            // permitiendo que las animaciones de CSS (popIn, slideIn) vuelvan a ejecutarse desde cero.
            void targetContent.offsetWidth; 
            targetContent.classList.add('active');
          }
        });
      });
    </script>
  </body>
</html>