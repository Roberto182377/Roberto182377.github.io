---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Definición de tus 7 certificados con sus respectivas insignias y PDFs
const certificaciones = [
  {
    id: "cert-1",
    titulo: "Introducción a la Ciberseguridad",
    resena: "Este certificado marcó un punto de inflexión en mi formación y fue mi primer contacto formal con este complejo ecosistema. A nivel técnico, logré interiorizar los pilares fundamentales: la tríada CIA y las bases de la gestión de riesgos. El aprendizaje más revelador fue comprender que las vulnerabilidades críticas no siempre provienen de fallas de software, sino del factor humano a través de la ingeniería social.",
    pdfUrl: "/docs/cert-ciberseguridad.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=🔒", // Reemplaza con la ruta de tu insignia/badge
  },
  {
    id: "cert-2",
    titulo: "Administración de amenazas cibernéticas",
    resena: "Esta certificación representó la transición de una visión operativa a una postura de defensa estratégica y táctica. El aprendizaje fundamental fue la implementación de modelos de inteligencia como el Diamond Model of Intrusion Analysis y el análisis de cadenas de exterminio para desarticular ataques complejos. Me capacitó para gestionar el ciclo de vida de un incidente bajo estándares internacionales.",
    pdfUrl: "/docs/cert-amenazas.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=🛡️",
  },
  {
    id: "cert-3",
    titulo: "Seguridad en Terminales",
    resena: "Análisis técnico centrado en el endurecimiento de endpoints y sistemas operativos. Implementación avanzada de políticas de control de acceso, monitoreo de integridad de archivos y mitigación de malware en tiempo real.",
    pdfUrl: "/docs/cert-endpoints.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=💻",
  },
  {
    id: "cert-4",
    titulo: "Conceptos básicos de redes",
    resena: "Comprensión profunda de la arquitectura de redes, protocolos TCP/IP, enrutamiento y conmutación. Base indispensable para mapear flujos de tráfico e identificar posibles puntos de interceptación o exfiltración de datos.",
    pdfUrl: "/docs/cert-redes.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=🌐",
  },
  {
    id: "cert-5",
    titulo: "Hacker Ético",
    resena: "Fase práctica enfocada en metodologías de penetration testing de caja negra y caja blanca. Identificación, explotación y posterior documentación responsable de vulnerabilidades críticas en entornos controlados.",
    pdfUrl: "/docs/cert-hacking.pdf",
    badgeUrl: "/assets/images/about/badgeC5.png",
  },
  {
    id: "cert-6",
    titulo: "Carrera Profesional de Analista Jr",
    resena: "Integración de competencias analíticas para el trabajo dentro de un SOC (Security Operations Center). Clasificación de alertas, correlación de eventos en SIEM y ejecución de playbooks defensivos.",
    pdfUrl: "/docs/cert-analista.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=📈",
  },
  {
    id: "cert-7",
    titulo: "Dispositivos y Defensa Perimetral",
    resena: "Configuración y auditoría de firewalls de próxima generación (NGFW), sistemas de prevención de intrusos (IDS/IPS) y pasarelas seguras para blindar el perímetro corporativo.",
    pdfUrl: "/docs/cert-dispositivos.pdf",
    badgeUrl: "https://placehold.co/60x60/151515/ededed?text=🧱",
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Certificaciones | Portafolio</title>
    <style>
      /* Variables Base de Soporte (Mecanismo de Modo Claro/Oscuro) */
      :root {
        --bg-main: #ffffff;
        --bg-card: #f8f9fa;
        --bg-hover: #f1f3f5;
        --text-title: #111111;
        --text-body: #333333;
        --text-muted: #6c757d;
        --border-ui: #e9ecef;
        --accent-color: #2563eb;
        --dot-color: rgba(0, 0, 0, 0.08);
      }

      /* Inversión automática al detectar clases oscuras comunes en portafolios Astro */
      :global(html.dark), :global(html[data-theme="dark"]), :global(body.dark) {
        --bg-main: #0a0a0a;
        --bg-card: #141414;
        --bg-hover: #1e1e1e;
        --text-title: #ededed;
        --text-body: #d1d1d1;
        --text-muted: #888888;
        --border-ui: rgba(255, 255, 255, 0.08);
        --dot-color: rgba(255, 255, 255, 0.15);
      }

      body {
        margin: 0;
        background-color: var(--bg-main);
        color: var(--text-body);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-image: 
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px),
          radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position: 0 0, 12px 20.78px;
        background-attachment: fixed;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 5rem 1.5rem;
      }

      header { 
        margin-bottom: 3.5rem; 
      }
      
      h1 { 
        font-size: 2.6rem; 
        font-weight: 800; /* Tipografía bien marcada */
        letter-spacing: -0.03em; 
        color: var(--text-title);
        margin: 0; 
      }

      /* Distribución en Grid Lateral */
      .cert-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 2.5rem;
        align-items: start;
      }

      /* PANEL IZQUIERDO: Estilo Lista Compacta Grupal */
      .cert-sidebar {
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 12px;
        overflow: hidden; /* Mantiene la cohesión de la lista */
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }

      .cert-btn {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--border-ui);
        color: var(--text-body);
        padding: 1.1rem 1.4rem;
        text-align: left;
        font-weight: 600; /* Texto firme y marcado */
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
      }

      /* Eliminar el borde inferior del último elemento de la lista */
      .cert-btn:last-child {
        border-bottom: none;
      }

      .cert-btn:hover {
        background-color: var(--bg-hover);
        color: var(--text-title);
        padding-left: 1.6rem; /* Sutil feedback de desplazamiento */
      }

      .cert-btn.active {
        background-color: var(--bg-hover);
        color: var(--accent-color);
      }

      /* Indicador lateral minimalista para el botón activo */
      .cert-btn.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background-color: var(--accent-color);
      }

      /* PANEL DERECHO: Visualizador de Contenido */
      .cert-viewer {
        background: var(--bg-card);
        border: 1px solid var(--border-ui);
        border-radius: 14px;
        padding: 2.5rem;
        min-height: 380px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }

      .cert-content {
        display: none;
      }

      .cert-content.active {
        display: block;
      }

      /* Animación coordinada de entrada */
      .cert-content.active .viewer-header,
      .cert-content.active .resena-box {
        animation: fadeInReveal 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes fadeInReveal {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Cabecera Interna: Título integrado con la Insignia/Badge */
      .viewer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-ui);
        padding-bottom: 1.5rem;
        margin-bottom: 1.8rem;
        gap: 1.5rem;
      }

      .title-integration {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        flex: 1;
      }

      /* Dimensiones controladas para la insignia */
      .cert-badge-img {
        width: 80pxpx;
        height: 80px;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.08));
      }

      .viewer-header h2 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700; /* Marcado fuerte */
        letter-spacing: -0.02em;
        color: var(--text-title);
        line-height: 1.3;
      }

      /* Botón de descarga de PDF */
      .btn-pdf {
        background: #dc2626;
        color: #ffffff;
        text-decoration: none;
        padding: 0.6rem 1.1rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s ease, transform 0.2s ease;
        flex-shrink: 0;
      }

      .btn-pdf:hover {
        background: #b91c1c;
        transform: translateY(-1px);
      }

      /* Bloque de Reseña */
      .resena-box {
        line-height: 1.7;
        color: var(--text-body);
        font-size: 1.05rem;
      }

      .resena-box p {
        margin: 0;
      }

      /* Responsividad para pantallas móviles */
      @media (max-width: 850px) {
        .cert-layout { 
          grid-template-columns: 1fr; 
          gap: 1.5rem;
        }
        .viewer-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        .btn-pdf {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <Navigation />
    
    <main class="container">
      <header>
        <h1>Certificaciones y Logros</h1>
      </header>

      <div class="cert-layout">
        <aside class="cert-sidebar">
          {certificaciones.map((cert, index) => (
            <button 
              class={`cert-btn ${index === 0 ? 'active' : ''}`} 
              data-target={cert.id}
            >
              {cert.titulo}
            </button>
          ))}
        </aside>

        <section class="cert-viewer">
          {certificaciones.map((cert, index) => (
            <div id={cert.id} class={`cert-content ${index === 0 ? 'active' : ''}`}>
              <div class="viewer-header">
                <div class="title-integration">
                  <img src={cert.badgeUrl} alt={`Insignia de ${cert.titulo}`} class="cert-badge-img" loading="lazy" />
                  <h2>{cert.titulo}</h2>
                </div>
                <a href={cert.pdfUrl} download class="btn-pdf">
                  📄 Descargar PDF
                </a>
              </div>
              
              <div class="resena-box">
                <p>{cert.resena}</p>
              </div>
            </div>
          ))}
        </section>
      </div>
    </main>

    <Footer />

    <script is:inline>
      const buttons = document.querySelectorAll('.cert-btn');
      const contents = document.querySelectorAll('.cert-content');

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          if (button.classList.contains('active')) return;

          buttons.forEach(btn => btn.classList.remove('active'));
          contents.forEach(content => content.classList.remove('active'));

          button.classList.add('active');

          const targetId = button.getAttribute('data-target');
          const targetContent = document.getElementById(targetId);
          
          if (targetContent) {
            void targetContent.offsetWidth; // Fuerza el reinicio de la animación limpia
            targetContent.classList.add('active');
          }
        });
      });
    </script>
  </body>
</html>