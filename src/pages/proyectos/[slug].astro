---
// src/pages/proyectos/[slug].astro
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { proyectosContent } from "../../config/content.ts";

// 1. Generar las rutas para cada proyecto basado en tu config
export async function getStaticPaths() {
  return proyectosContent.projects.map((project) => {
    // Extraemos el slug del href (ej: "/proyectos/proyecto-01" -> "proyecto-01")
    const slug = project.href.split('/').pop();
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { slug } = Astro.params;
const { project } = Astro.props;

// 2. Intentar cargar el contenido del Markdown dinámicamente
// Nota: Ajusta la ruta a donde guardes tus .md
const allPosts = await Astro.glob("../../content/proyectos/*.md");
const post = allPosts.find((p) => p.file.includes(`${slug}.md`));

if (!post) {
  return Astro.redirect('/404');
}

const { Content, frontmatter } = post;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | Proyectos</title>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"></div>
    </div>

    <main class="relative z-10 flex flex-col min-h-screen">
      <Navigation />
      
      <article class="relative z-20 max-w-3xl mx-auto mt-32 mb-20 px-7 lg:px-0">
        <header class="mb-10">
          <h1 class="text-4xl font-bold text-neutral-900 dark:text-neutral-100 mb-4">
            {frontmatter.title}
          </h1>
          <p class="text-neutral-600 dark:text-neutral-400 italic">
            {frontmatter.description}
          </p>
        </header>

        <div class="prose prose-neutral dark:prose-invert max-w-none 
                    text-neutral-800 dark:text-neutral-300
                    prose-headings:text-neutral-900 dark:prose-headings:text-neutral-100">
          <Content />
        </div>
      </article>
      
      <Footer />
    </main>
  </body>
</html>

<style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow-x: hidden;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      section[class*="text-gray-700"] {
        margin: 0;
        padding: 0;
        flex-shrink: 0;
      }
      .prose h1:first-of-type,
      .prose > h1:first-child,
      article .prose h1:first-child {
        display: none !important;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>